<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-currency="{{ cart.currency | default: shop.currency }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#070a08">
    <script>document.documentElement.classList.add('js');</script>

    {%- comment -%}
      Default to dark mode on every storefront template. A visitor can switch
      to light mode with the header control; that explicit choice is persisted.
      This runs before CSS to prevent a light flash on first paint.
    {%- endcomment -%}
    <script>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('vesper-theme-v2'); } catch (e) {}

        var wantsDark = stored !== 'light';
        if (wantsDark) root.setAttribute('data-theme', 'dark');
        else root.removeAttribute('data-theme');

        function syncMeta() {
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', root.getAttribute('data-theme') === 'dark' ? '#070a08' : '#f8f7f4');
        }
        syncMeta();

        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
            button.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'dark' ? 'true' : 'false');
          });
        });

        document.addEventListener('click', function (event) {
          var trigger = event.target.closest ? event.target.closest('[data-theme-toggle]') : null;
          if (!trigger) return;
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          if (next === 'dark') root.setAttribute('data-theme', 'dark');
          else root.removeAttribute('data-theme');
          try { localStorage.setItem('vesper-theme-v2', next); } catch (e) {}
          document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
            button.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
          });
          syncMeta();
        });
      })();
    </script>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@500;600;700;800&display=swap"
    >

    {%- if template.name == 'index' -%}
      {%- comment -%}
        Home page — Vesper Robot landing page (ported from vesper-robot-theme).
        Keeps the compiled landing bundle and the Barlow font stack.
      {%- endcomment -%}
      {%- comment -%} Barlow and Barlow Condensed are loaded globally to match Nuxt. {%- endcomment -%}

      <title>{{ shop.name }}</title>

      {%- if page_description -%}
        <meta name="description" content="{{ page_description | escape }}">
      {%- endif -%}
      <link rel="canonical" href="{{ canonical_url }}">

      {{ 'vesper-robot.css' | asset_url | stylesheet_tag }}
      {{ 'vesper-core.css' | asset_url | stylesheet_tag }}
      {{ 'vesper-home-dark.css' | asset_url | stylesheet_tag }}

      {%- comment -%}
        Mobile-only overrides for the landing page. Kept inline on purpose: it is
        under 3 KB and avoids an extra render-blocking request on the critical path.
        Desktop markup and styles are untouched.
      {%- endcomment -%}
      <style id="vesper-mobile-index">
        @media (max-width: 767px) {
          /* 1. The template already renders the booking form right after the hero,
             so phones need no reordering — only the shortening below. */

          /* 2. Non-essential blocks are removed on mobile to shorten the page.
             The last one is the "Expert Reviews" app section: six YouTube embeds. */
          body.template-index #problem,
          body.template-index #demonstrations,
          body.template-index #why-vesper,
          body.template-index #how-it-works,
          body.template-index #main-content > .shopify-section[id$="__1791268772f7af4e36"] {
            display: none !important;
          }

          /* 3. Compact hero. */
          body.template-index #home-hero {
            min-height: 62svh !important;
          }
          body.template-index #home-hero > div:last-child {
            padding-bottom: 28px !important;
          }
          body.template-index #home-hero h1 {
            font-size: 38px !important;
            margin-bottom: 12px !important;
          }
          body.template-index #home-hero p {
            font-size: 15px !important;
            line-height: 1.5 !important;
            margin-bottom: 20px !important;
          }
          body.template-index #home-hero [data-hero-cta] {
            display: block;
            width: 100%;
            padding: 16px 24px !important;
            font-size: 13px !important;
            text-align: center;
          }

          /* 4. Tighter section rhythm. */
          body.template-index #demo,
          body.template-index #products,
          body.template-index #faq,
          body.template-index #cta {
            padding-top: 44px !important;
            padding-bottom: 44px !important;
          }

          /* 5. Form first inside the demo section. */
          body.template-index #demo {
            scroll-margin-top: 56px;
          }
          body.template-index #demo > div > .grid {
            display: flex;
            flex-direction: column;
            gap: 24px;
          }
          body.template-index #demo > div > .grid > div:last-child {
            order: -1;
            padding: 18px !important;
          }
          /* The form is rendered by the Forms app after load; reserving its
             height keeps the sections below it from jumping. */
          body.template-index #demo [data-form-root] {
            min-height: 800px;
          }
        }

        {%- comment -%}
          The demo section sits second in templates/index.json so that phones get
          the form early in the HTML (a late insertion would shift every section
          below it). Desktop keeps its original sequence via flex order.
        {%- endcomment -%}
        @media (min-width: 768px) {
          body.template-index #main-content {
            display: flex;
            flex-direction: column;
          }
          body.template-index #main-content > .shopify-section {
            flex: none;
            width: 100%;
          }
          body.template-index #main-content > .shopify-section[id$="__products"] { order: 1; }
          body.template-index #main-content > .shopify-section[id$="__problem"] { order: 2; }
          body.template-index #main-content > .shopify-section[id$="__demonstrations"] { order: 3; }
          body.template-index #main-content > .shopify-section[id$="__why"] { order: 4; }
          body.template-index #main-content > .shopify-section[id$="__1791268772f7af4e36"] { order: 5; }
          body.template-index #main-content > .shopify-section[id$="__process"] { order: 6; }
          body.template-index #main-content > .shopify-section[id$="__demo"] { order: 7; }
          body.template-index #main-content > .shopify-section[id$="__faq"] { order: 8; }
          body.template-index #main-content > .shopify-section[id$="__cta"] { order: 9; }
        }
      </style>
    {%- else -%}
      {%- comment -%}
        All other templates — aligned to the home page design system.

        The home page (vesper-robot.css + vesper-core.css) is the single
        source of truth for header, footer, typography and colour. Every
        other template loads the same layers on top of the page-level
        styles so the whole store reads as one brand:

          critical.css        base reset
          vesper-base.css     page-level component styles
          vesper-robot.css    utility classes used by header/footer
          vesper-core.css     brand tokens (--v-*) + shared components
          vesper-unify.css    final alignment: fonts + colours
      {%- endcomment -%}
      {% render 'css-variables' %}

      {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
      {{ 'vesper-base.css' | asset_url | stylesheet_tag }}
      {{ 'vesper-robot.css' | asset_url | stylesheet_tag }}
      {{ 'vesper-core.css' | asset_url | stylesheet_tag }}
      {{ 'vesper-unify.css' | asset_url | stylesheet_tag }}

      {% render 'meta-tags' %}
    {%- endif -%}

    {{ 'vesper-type.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  {%- if template.name == 'index' -%}
    <body class="template-index">
      <a class="v-visually-hidden" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

      {% sections 'header-group' %}

      <main id="main-content">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}

      <script src="{{ 'vesper-robot.js' | asset_url }}" defer></script>
      <script src="{{ 'vesper-core.js' | asset_url }}" defer></script>
      <script src="{{ 'vesper-tracking.js' | asset_url }}" defer></script>
    </body>
  {%- else -%}
    <body class="vesper-theme template-{{ template.name | handle }}">
      {% sections 'header-group' %}

      <main id="MainContent" class="v-main" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}

      {% render 'vesper-cart-drawer' %}

      <div class="v-toast-stack" data-vesper-toasts aria-live="polite"></div>

      <script src="{{ 'vesper.js' | asset_url }}" defer></script>
      <script src="{{ 'vesper-tracking.js' | asset_url }}" defer></script>

     <script>
document.addEventListener('DOMContentLoaded', function(){
  document.addEventListener('click', function(e){
    const linkEl = e.target.closest('a[href*="wa.me"]');
    if(!linkEl) return;
    e.preventDefault();
    const targetUrl = linkEl.href;
    // 判断：如果是Zotabox弹窗按钮，标记zotabox；导航栏按钮标记header
    let source = 'header';
    if(linkEl.closest('[class*="zotabox"]')){
      source = 'zotabox';
    }
    gtag('event', 'conversion', {
      'send_to': 'AW-18471097817/TOVHCJTC0KYdENmr2udE',
      'value': 40.0,
      'currency': 'AUD',
      'button_source': source,
      'event_callback': function(){
        window.location.href = targetUrl;
      }
    });
  })
})
</script>
    </body>
  {%- endif -%}
</html>
