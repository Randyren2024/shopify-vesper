<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f8f7f4">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if template.name == 'index' -%}
      {%- comment -%}
        Home page — Vesper Robot landing page (ported from vesper-robot-theme).
        Keeps the compiled landing bundle and the Barlow font stack.
      {%- endcomment -%}
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600;700&display=swap"
      >

      <title>
        {{ page_title }}
        {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
        {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
        {%- unless page_title contains 'Vesper Robot' %} &ndash; Vesper Robot{% endunless -%}
      </title>

      {%- if page_description -%}
        <meta name="description" content="{{ page_description | escape }}">
      {%- endif -%}
      <link rel="canonical" href="{{ canonical_url }}">

      {{ 'vesper-robot.css' | asset_url | stylesheet_tag }}
      {{ 'vesper-core.css' | asset_url | stylesheet_tag }}
    {%- else -%}
      {%- comment -%}
        All other templates — Vesper AgriTech theme (ported from theme/).
      {%- endcomment -%}
      {% render 'css-variables' %}

      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Sans:wght@400;500;600;700&display=swap"
      >

      {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
      {{ 'vesper-base.css' | asset_url | stylesheet_tag }}

      {% render 'meta-tags' %}
    {%- endif -%}

    {{ content_for_header }}
  </head>

  {%- if template.name == 'index' -%}
    <body>
      <a class="v-visually-hidden" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

      {% sections 'header-group' %}

      <main id="main-content">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}

      <script src="{{ 'vesper-robot.js' | asset_url }}" defer></script>
      <script src="{{ 'vesper-core.js' | asset_url }}" defer></script>
    </body>
  {%- else -%}
    <body class="vesper-theme template-{{ template.name | handle }}">
      {% sections 'agri-header-group' %}

      <main id="MainContent" class="v-main" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% sections 'agri-footer-group' %}

      {% render 'vesper-cart-drawer' %}

      <div class="v-toast-stack" data-vesper-toasts aria-live="polite"></div>

      <script src="{{ 'vesper.js' | asset_url }}" defer></script>
    </body>
  {%- endif -%}
</html>
