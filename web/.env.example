# ---------------------------------------------------------------------------
# Shopify Storefront API
#
# Create a Headless sales channel (or a custom app with the
# "unauthenticated_read_product_listings" + "unauthenticated_write_checkouts"
# scopes) in the Shopify admin, then copy the public Storefront API token here.
#
# These values are server-side only. Never commit the real .env file.
# ---------------------------------------------------------------------------
NUXT_SHOPIFY_DOMAIN=01qfgs-sv.myshopify.com
NUXT_SHOPIFY_STOREFRONT_TOKEN=

# Optional overrides
NUXT_SHOPIFY_API_VERSION=2025-10
NUXT_PUBLIC_SITE_URL=https://www.vesperrobot.au
NUXT_PUBLIC_STORE_DOMAIN=www.vesperrobot.au

# ---------------------------------------------------------------------------
# Shopify Admin API (lead capture)
#
# Custom app "Vesper Leads API" with the write_customers scope. Client
# credentials are exchanged for a short-lived token at runtime, so nothing has
# to be rotated by hand. A static token can be used instead via
# NUXT_SHOPIFY_ADMIN_TOKEN.
# ---------------------------------------------------------------------------
NUXT_SHOPIFY_ADMIN_CLIENT_ID=
NUXT_SHOPIFY_ADMIN_CLIENT_SECRET=

