{% schema %}
{
  "name": "In-home demo form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In-Home Demo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Want to See If It Works In Your Home?" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Book an in-home demo and see how the robot performs in your actual yard, pool, or floors." },
    { "type": "textarea", "id": "bullets", "label": "Bullets", "info": "One per line", "default": "Free for Melbourne East area\nNo commitment required\nExpert visits your home" },
    { "type": "text", "id": "form_success", "label": "Success message", "default": "Thanks! Your demo request has been received. We'll contact you within one business day." },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "REQUEST MY FREE DEMO" }
  ],
  "presets": [{ "name": "In-home demo form" }]
}
{% endschema %}
