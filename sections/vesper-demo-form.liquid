{%- comment -%}
  In-home demo request form.
  This is a native Shopify contact form so the theme tracking bridge can
  observe its successful response page and emit the Nuxt-compatible lead event.
{%- endcomment -%}

<section id="demo" class="py-24 md:py-32" style="background: rgb(17, 17, 16);">
  <style>
    #demo .demo-form-card { background: #f8f7f4; color: #171916; padding: 28px; border-radius: 4px; }
    #demo .demo-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    #demo .demo-form-field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
    #demo .demo-form-field--full { grid-column: 1 / -1; }
    #demo .demo-form-field label { color: #30342f; font: 600 12px/1.4 Barlow, sans-serif; letter-spacing: .04em; }
    #demo .demo-form-field input, #demo .demo-form-field select, #demo .demo-form-field textarea {
      width: 100%; min-height: 48px; box-sizing: border-box; border: 1px solid #c9cbc5;
      border-radius: 3px; background: #fff; color: #171916; padding: 12px 13px;
      font: 400 14px/1.5 Barlow, sans-serif;
    }
    #demo .demo-form-field textarea { min-height: 104px; resize: vertical; }
    #demo .demo-form-field input:focus, #demo .demo-form-field select:focus, #demo .demo-form-field textarea:focus {
      outline: 2px solid #78bd18; outline-offset: 1px; border-color: #78bd18;
    }
    #demo .demo-form-submit { width: 100%; min-height: 52px; margin-top: 20px; border: 0; cursor: pointer; }
    #demo .demo-form-success { padding: 14px 16px; margin: 0 0 18px; background: #e8f4dc; color: #24440c; border-left: 3px solid #78bd18; font: 500 14px/1.6 Barlow, sans-serif; }
    #demo .demo-form-errors { margin: 0 0 18px; color: #9e2424; font: 500 14px/1.5 Barlow, sans-serif; }
    @media (max-width: 640px) { #demo .demo-form-card { padding: 20px; } #demo .demo-form-grid { grid-template-columns: 1fr; } #demo .demo-form-field--full { grid-column: auto; } }
  </style>

  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20">
      <div class="demo-copy-panel" style="background: rgb(17, 17, 16); color: rgb(248, 247, 244); min-height: 100%; padding: 12px 0;">
        <p class="uppercase mb-8" style="font-family: Barlow, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; color: rgb(107, 107, 104);">{{ section.settings.eyebrow }}</p>
        <h2 class="text-[36px] md:text-[52px] uppercase tracking-tight mb-8" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 700; color: rgb(248, 247, 244); line-height: 1;">{{ section.settings.heading }}</h2>
        <p class="mb-10" style="font-family: Barlow, sans-serif; font-size: 16px; color: rgba(248, 247, 244, 0.72); line-height: 1.7; max-width: 400px;">{{ section.settings.body }}</p>

        {%- if section.settings.bullets != blank -%}
          <div class="space-y-3">
            {%- assign bullets = section.settings.bullets | newline_to_br | split: '<br />' -%}
            {%- for bullet in bullets -%}
              <div class="flex items-center gap-3" style="font-family: Barlow, sans-serif; font-size: 14px; color: rgba(248, 247, 244, 0.72);">
                <span style="width: 16px; height: 1px; background: rgb(200, 90, 10); display: inline-block; flex-shrink: 0;"></span>{{ bullet | strip }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="demo-form-card" data-lead-form="home_demo">
        <h3 style="margin: 0 0 8px; color: #171916; font: 700 25px/1.1 'Barlow Condensed', sans-serif; text-transform: uppercase;">Request Your Free Demo</h3>
        <p style="margin: 0 0 22px; color: #62665f; font: 400 14px/1.6 Barlow, sans-serif;">Tell us a little about your home and we'll get back to you within one business day.</p>

        {%- form 'contact', id: 'home_demo_contact_form' -%}
          {%- if form.posted_successfully? -%}
            <p class="demo-form-success" role="status" data-lead-success data-lead-form="home_demo">{{ section.settings.form_success }}</p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="demo-form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="demo-form-grid">
            <div class="demo-form-field">
              <label for="home-demo-name">Full name *</label>
              <input id="home-demo-name" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" placeholder="Your full name" required>
            </div>
            <div class="demo-form-field">
              <label for="home-demo-email">Email address *</label>
              <input id="home-demo-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" placeholder="you@example.com" required>
            </div>
            <div class="demo-form-field">
