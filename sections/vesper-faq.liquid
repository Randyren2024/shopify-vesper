<section id="faq" class="py-24 md:py-32" style="background: rgb(248, 247, 244);">
  <div class="max-w-3xl mx-auto px-6">
    <p
      class="uppercase mb-8"
      style="font-family: Barlow, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; color: rgb(107, 107, 104);"
    >{{ section.settings.eyebrow }}</p>

    <h2
      class="text-[36px] md:text-[48px] uppercase tracking-tight mb-12"
      style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 700; color: rgb(17, 17, 16); line-height: 1;"
    >{{ section.settings.heading }}</h2>

    <div style="border-top: 1px solid rgba(17, 17, 16, 0.1);" data-accordion>
      {%- for block in section.blocks -%}
        <div
          style="border-bottom: 1px solid rgba(17, 17, 16, 0.1);"
          data-accordion-item
          data-open="false"
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="w-full text-left py-5 flex items-center justify-between gap-4 group"
            aria-expanded="false"
            aria-controls="faq-panel-{{ block.id }}"
            data-accordion-trigger
          >
            <span
              class="group-hover:text-[#1E3D1E] transition-colors"
              style="font-family: Barlow, sans-serif; font-weight: 600; font-size: 15px; color: rgb(17, 17, 16); letter-spacing: 0.01em;"
            >{{ block.settings.question }}</span>
            <span
              style="color: rgb(107, 107, 104); font-size: 20px; line-height: 1; flex-shrink: 0; transform: none; transition: transform 0.25s;"
              data-accordion-icon
            >+</span>
          </button>

          <p
            id="faq-panel-{{ block.id }}"
            style="font-family: Barlow, sans-serif; font-size: 15px; color: rgb(107, 107, 104); line-height: 1.7; padding-bottom: 20px;"
            data-accordion-panel
            hidden
          >{{ block.settings.answer }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common Questions."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
