      assign vpd_best = 'true'
    when 'w20'
      assign vpd_code = 'W20'
      assign vpd_name = 'Land Leveling System'
      assign vpd_category_name = 'Land Leveling System'
      assign vpd_category_id = 'land-leveling'
      assign vpd_tagline = 'The W20 is a GNSS-based smart land leveling system designed to replace inefficient manual methods'
      assign vpd_badges = 'STABLE PERFORMANCE|USER-FRIENDLY DESIGN|UPGRADED ALGORITHMS|SMART OPERATION|QUICK HEIGHT CALIBRATION|TERRAIN SURVEY & DESIGN'
      assign vpd_why = 'Developed by Vesper, the W20 Intelligent GNSS Land Leveling System is a high-precision alternative to traditional laser leveling|Compatible with land levelers, scrapers, bulldozers, and graders, offering precise guidance and automated blade control for optimal performance|Minimizes operator fatigue and skill requirements, ensuring accurate results in farmland leveling and paddy field transformation|Ideal for land reclamation, site preparation, and roadbed work where high surface flatness is essential|Improves soil moisture retention, enables precise irrigation, and reduces input waste for significantly enhanced field productivity'
      assign vpd_features = 'STABLE PERFORMANCE|USER-FRIENDLY DESIGN|UPGRADED ALGORITHMS|SMART OPERATION|QUICK HEIGHT CALIBRATION|TERRAIN SURVEY & DESIGN'
      assign vpd_image = 'products-w20-main.png'
      assign vpd_price_text = '$8,999.00'
    when 'aries300n'
      assign vpd_code = 'Aries300N'
      assign vpd_name = 'Orchard Spraying Robot'
      assign vpd_category_name = 'Agricultural Robots'
      assign vpd_category_id = 'agricultural-robotics'
      assign vpd_tagline = 'A hybrid-powered orchard spraying robot combining GNSS navigation, autonomous driving, and obstacle avoidance'
      assign vpd_badges = 'EFFICIENT|STABLE|PREMIUM|ACCURATE|UPGRADABLE'
      assign vpd_why = 'Combines GNSS navigation, autonomous driving, obstacle avoidance, and intelligent operation — goodbye to manual driving in orchards|Robust design with stable performance in challenging terrain, slopes, and dense orchard environments|Reliable operation with cost-effective efficiency — reduces labor costs by up to 60% compared to manual spraying|Flexible mode switching between autonomous and manual operation for diverse orchard layouts and spray requirements|Hybrid gasoline-electric power system enables extended runtime up to 8 hours with 300L tank capacity'
      assign vpd_features = 'Autonomous navigation|Hybrid power (Gasoline-Electric)|Air-assisted spraying|Night mode operation|3-10m spray width|GNSS-guided precision'
      assign vpd_image = 'products-aries300n-main.png'
      assign vpd_price_text = '$5,999.00'
      assign vpd_best = 'true'
    when 'taurus80e'
      assign vpd_code = 'Taurus80E'
      assign vpd_name = 'Smart Lawn Mowing Robot'
      assign vpd_category_name = 'Agricultural Robots'
      assign vpd_category_id = 'agricultural-robotics'
      assign vpd_tagline = 'Autonomous Electric Mowing for Professional Operations'
      assign vpd_badges = 'EFFICIENT|STABLE|PREMIUM|ACCURATE|UPGRADABLE'
      assign vpd_why = 'High-precision centimeter-level positioning for maximum field efficiency|Robust hardware platform engineered for harsh agricultural environments|Intelligent automation reduces operator fatigue and human errors|Seamless OTA updates keep your system future-proof'
      assign vpd_features = 'Autonomous navigation|Electric powered (48V Lithium)|Low noise operation|24/7 working|Slope capability'
      assign vpd_image = 'products-80e-1.webp'
      assign vpd_price_text = '$3,999.00'
      assign vpd_best = 'true'
    when 'egs101'
      assign vpd_code = 'EGS101'
      assign vpd_name = 'Intelligent Excavator Guidance System'
      assign vpd_category_name = 'Machine Control'
      assign vpd_category_id = 'machine-control'
      assign vpd_tagline = 'Works seamlessly with a wide range of excavator models, providing precise real-time guidance for digging and grading'
      assign vpd_badges = 'EFFICIENT|STABLE|ACCURATE|UPGRADABLE'
      assign vpd_why = 'Works seamlessly with a wide range of excavator models, providing precise real-time guidance for digging depth control and slope matching|Combines GNSS and laser sensors for accurate 2D and 3D grade control in all working conditions|Reduces over-digging by up to 80%, saving time on backfill and material costs|Intuitive 7-inch display shows real-time bucket position relative to target grade, eliminating the need for grade checkers|Quick installation and calibration — move the system between machines in under 30 minutes'
      assign vpd_features = 'Grade control|Depth display|Slope matching|2D/3D control|GNSS + Laser sensors|±3 cm accuracy'
      assign vpd_image = 'products-egs101-main.png'
      assign vpd_price_text = '$2,499.00'
    when 'v600'
      assign vpd_code = 'TerraMow V600'
      assign vpd_name = 'Auto Mower'
      assign vpd_category_name = 'Lawn Mower'
      assign vpd_category_id = 'lawn-mower'
      assign vpd_tagline = 'Triple-camera AI vision mowing — no boundary wire, no RTK antenna, no signal dropouts'
      assign vpd_badges = 'AI VISION|TRIPLE CAMERA|AUTO MAPPING|APP CONTROL|OBSTACLE AVOIDANCE|EDGE CUTTING'
      assign vpd_why = 'A triple-camera AI vision system reads the lawn in real time, so the V600 navigates and mows without boundary wire, RTK antenna or satellite signal|One tap in the app is all the setup it needs — the mower builds an accurate map of your lawn by itself|AI vision and CMOS sensors spot toys, hoses, pets and other obstacles as they appear, then steer around them so a mowing session is never interrupted|Cuts right along the border with roughly 15 cm of adjustable offset, leaving a finish that needs no tidying up afterwards|Three mowing modes — a quick trim, a standard cut or an intensive mow — matched to how fast your lawn is growing|Fully electric drive means no petrol, no emissions and far lower running costs than a ride-on mower'
      assign vpd_features = 'Triple-camera AI vision, 360° awareness|Wire-free: no boundary wire, no RTK antenna|One-tap app mapping and scheduling|Real-time obstacle avoidance|Cutting height 1"–3"|Three mowing modes: trim, standard, intensive|Edge cutting with about 15 cm adjustable offset'
      assign vpd_price_text = '$1,999.99'
      assign vpd_new = 'true'
    when 'v1000'
      assign vpd_code = 'TerraMow V1000'
      assign vpd_name = 'Auto Mower'
      assign vpd_category_name = 'Lawn Mower'
      assign vpd_category_id = 'lawn-mower'
      assign vpd_tagline = 'Triple-camera AI vision mowing — no boundary wire, no RTK antenna, no signal dropouts'
      assign vpd_badges = 'AI VISION|TRIPLE CAMERA|AUTO MAPPING|APP CONTROL|OBSTACLE AVOIDANCE|EDGE CUTTING'
      assign vpd_why = 'A triple-camera AI vision system reads the lawn in real time, so the V1000 navigates and mows without boundary wire, RTK antenna or satellite signal|One tap in the app is all the setup it needs — the mower builds an accurate map of your lawn by itself|AI vision and CMOS sensors spot toys, hoses, pets and other obstacles as they appear, then steer around them so a mowing session is never interrupted|Cuts right along the border with roughly 15 cm of adjustable offset, leaving a finish that needs no tidying up afterwards|Three mowing modes — a quick trim, a standard cut or an intensive mow — matched to how fast your lawn is growing|Fully electric drive means no petrol, no emissions and far lower running costs than a ride-on mower'
      assign vpd_features = 'Triple-camera AI vision, 360° awareness|Wire-free: no boundary wire, no RTK antenna|One-tap app mapping and scheduling|Real-time obstacle avoidance|Cutting height 1"–3"|Three mowing modes: trim, standard, intensive|Edge cutting with about 15 cm adjustable offset'
      assign vpd_price_text = '$2,499.99'
      assign vpd_new = 'true'
  endcase

  assign vpd_whatsapp = section.settings.whatsapp_number | default: settings.vesper_whatsapp_number
  assign vpd_share_url = shop.url
  if product != blank
    assign vpd_share_url = shop.url | append: product.url
  endif
  assign vpd_share_title = vpd_code | append: ' ' | append: vpd_name
  assign vpd_alt = vpd_code | append: ' ' | append: vpd_name
-%}

<div class="vpd-page">
  {%- if vpd_code != blank -%}
    <div class="vpd-breadcrumb">
      <div class="v-container">
        <nav class="v-breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          {%- render 'vesper-icons', icon: 'chevron-right' -%}
          <a href="/pages/products-solutions">Products &amp; Solutions</a>
          {%- render 'vesper-icons', icon: 'chevron-right' -%}
          <a href="/pages/products-solutions?category={{ vpd_category_id }}">{{ vpd_category_name }}</a>
          {%- render 'vesper-icons', icon: 'chevron-right' -%}
          <span aria-current="page">{{ vpd_code }}</span>
        </nav>
      </div>
    </div>
  {%- endif -%}

  <section class="vpd-hero">
    <div class="v-container">
      <div class="vpd-hero__container">
        <div class="vpd-gallery" data-reveal="left">
          {%- if product == blank -%}
            <img class="vpd-gallery__image" src="{{ vpd_image | asset_url }}" alt="{{ vpd_alt | escape }}" loading="eager">
          {%- elsif product.images.size > 1 -%}
            <div class="v-carousel vpd-gallery__carousel" data-carousel>
              <div class="v-carousel__track" data-carousel-track>
                {%- for image in product.images -%}
                  <div class="v-carousel__slide">
                    <img
                      class="vpd-gallery__image"
                      src="{{ image | image_url: width: 1200 }}"
                      alt="{{ image.alt | default: vpd_alt | escape }}"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
                  </div>
                {%- endfor -%}
              </div>
              <div class="v-carousel__nav">
                <button type="button" class="v-carousel__btn" data-carousel-prev aria-label="Previous image">
                  {%- render 'vesper-icons', icon: 'chevron-left' -%}
                </button>
                <button type="button" class="v-carousel__btn" data-carousel-next aria-label="Next image">
                  {%- render 'vesper-icons', icon: 'chevron-right' -%}
                </button>
              </div>

              <div class="vpd-thumbs">
                {%- for image in product.images -%}
                  <button
                    type="button"
                    class="vpd-thumb{% if forloop.first %} is-active{% endif %}"
                    data-carousel-thumb="{{ forloop.index0 }}"
                    aria-label="Show image {{ forloop.index }}"
                  >
                    <img
                      src="{{ image | image_url: width: 200 }}"
                      alt=""
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      loading="lazy">
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- elsif product.featured_image != blank -%}
            <img
              class="vpd-gallery__image"
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | default: vpd_alt | escape }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              loading="eager">
          {%- else -%}
            <img class="vpd-gallery__image" src="{{ vpd_image | asset_url }}" alt="{{ vpd_alt | escape }}" loading="eager">
          {%- endif -%}

          {%- if vpd_code != blank -%}
            <div class="vpd-badges">
              <span class="vpd-stock-badge vpd-stock-badge--in">In Stock</span>
              {%- if vpd_best == 'true' -%}
                <span class="vpd-stock-badge vpd-stock-badge--best">Best Seller</span>
              {%- endif -%}
              {%- if vpd_new == 'true' -%}
                <span class="vpd-stock-badge vpd-stock-badge--new">New Release</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_share and vpd_code != blank -%}
            <div class="vpd-share">
              <span class="vpd-share__label">Share:</span>
              <a class="vpd-share__btn" href="https://twitter.com/intent/tweet?url={{ vpd_share_url | url_encode }}&amp;text={{ vpd_share_title | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Twitter">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22 5.9c-.7.3-1.5.5-2.3.6.8-.5 1.4-1.3 1.7-2.2-.8.5-1.6.8-2.5 1a3.9 3.9 0 0 0-6.7 3.6A11.1 11.1 0 0 1 4.1 4.8a3.9 3.9 0 0 0 1.2 5.2c-.6 0-1.2-.2-1.7-.5v.1c0 1.9 1.3 3.5 3.1 3.8-.6.2-1.2.2-1.8.1.5 1.6 2 2.7 3.6 2.8A7.9 7.9 0 0 1 2 18.8a11 11 0 0 0 6 1.8c7.2 0 11.2-6 11.2-11.2v-.5c.8-.6 1.4-1.3 1.8-2z"/></svg>
              </a>
              <a class="vpd-share__btn" href="https://www.facebook.com/sharer/sharer.php?u={{ vpd_share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.4V13h2.2v8z"/></svg>
              </a>
              <a class="vpd-share__btn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ vpd_share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
                {%- render 'vesper-icons', icon: 'linkedin' -%}
              </a>
            </div>
          {%- endif -%}
        </div>

        <div class="vpd-info" data-reveal="right">
          {%- if vpd_code != blank -%}
            <div class="vpd-category">
              <a href="/pages/products-solutions?category={{ vpd_category_id }}">{{ vpd_category_name }}</a>
            </div>
            <h1 class="vpd-title">{{ vpd_code }} {{ vpd_name }}</h1>
            <p class="vpd-tagline">{{ vpd_tagline }}</p>

            <div class="vpd-feature-badges">
              {%- assign vpd_badge_items = vpd_badges | split: '|' -%}
              {%- for badge in vpd_badge_items -%}
                <span class="vpd-feature-badge">{{ badge }}</span>
              {%- endfor -%}
            </div>

            <div class="v-accordion vpd-accordion" data-accordion>
              <div class="v-accordion__item" data-open="false">
                <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
                  <span>Why You'll Choose It</span>
                  {%- render 'vesper-icons', icon: 'chevron-down' -%}
                </button>
                <div class="v-accordion__panel">
                  <ul class="vpd-check-list">
                    {%- assign vpd_why_items = vpd_why | split: '|' -%}
                    {%- for reason in vpd_why_items -%}
                      <li>{% render 'vesper-icons', icon: 'check' %}<span>{{ reason }}</span></li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
              <div class="v-accordion__item" data-open="false">
                <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
                  <span>Features</span>
                  {%- render 'vesper-icons', icon: 'chevron-down' -%}
                </button>
                <div class="v-accordion__panel">
                  <ul class="vpd-check-list">
                    {%- assign vpd_feature_items = vpd_features | split: '|' -%}
                    {%- for feature in vpd_feature_items -%}
                      <li>{% render 'vesper-icons', icon: 'check' %}<span>{{ feature }}</span></li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </div>

            {%- if shop.enabled_payment_types.size > 0 -%}
              <div class="vpd-payments">
                <span class="vpd-payments__label">Secure payment:</span>
                <ul class="v-payment-icons" aria-label="Accepted payment methods">
                  {%- for type in shop.enabled_payment_types -%}
                    <li class="v-payment-icons__item">{{ type | payment_type_svg_tag: class: 'v-payment-icons__svg' }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <div class="vpd-cta-buttons">
              <button type="button" class="v-btn v-btn--pill-primary v-btn--lg" data-request-demo data-whatsapp="{{ vpd_whatsapp }}" data-message="Hello! I would like to request a demo of the {{ vpd_code }} {{ vpd_name }}.">
                {%- render 'vesper-icons', icon: 'phone' -%}
                <span>Request a Demo</span>
              </button>
              <button type="button" class="v-btn v-btn--pill v-btn--lg" data-request-demo data-whatsapp="{{ vpd_whatsapp }}" data-message="Hello! I'm interested in getting a quote for the {{ vpd_code }} {{ vpd_name }}. Could you please provide more information?">
                {%- render 'vesper-icons', icon: 'whatsapp' -%}
                <span>Get a Quote</span>
              </button>
            </div>
          {%- endif -%}

          {%- liquid
            assign vpd_variant = nil
            if product != blank
              assign vpd_variant = product.selected_or_first_available_variant
            endif
          -%}

          <div class="vpd-ecommerce" id="vpd-buy">
            {%- if vpd_variant == nil -%}
              <div class="vpd-price-section">
                <span class="vpd-price-current">{{ vpd_price_text }}</span>
                <span class="vpd-price-stock vpd-price-stock--out">Coming soon</span>
              </div>
              <button type="button" class="v-btn v-btn--primary v-btn--block v-btn--lg vpd-add-to-cart" disabled>Coming soon</button>
            {%- else -%}
              <form data-product-form class="vpd-form">
                <div class="vpd-price-section">
                  <span class="vpd-price-current" data-variant-price>{{ vpd_variant.price | money }}</span>
                  <span class="vpd-price-compare" data-variant-compare {% unless vpd_variant.compare_at_price > vpd_variant.price %}hidden{% endunless %}>
                    {%- if vpd_variant.compare_at_price > vpd_variant.price -%}{{ vpd_variant.compare_at_price | money }}{%- endif -%}
                  </span>
                  <span class="vpd-price-stock{% unless vpd_variant.available %} vpd-price-stock--out{% endunless %}" data-variant-stock>
                    {%- if vpd_variant.available -%}In stock{%- else -%}Out of Stock{%- endif -%}
                  </span>
                </div>

                {%- unless vpd_variant.available -%}
                  <div class="vpd-out-of-stock">
                    <p>This product is currently unavailable. Please contact us for more information or to join the waitlist.</p>
                  </div>
                {%- endunless -%}

                <div class="vpd-quantity">
                  <label class="vpd-quantity-label" for="vpd-qty-{{ section.id }}">Quantity:</label>
                  <div class="vpd-qty" data-qty>
                    <div class="v-qty">
                      <button type="button" data-qty-step="-1" aria-label="Decrease quantity">
                        {%- render 'vesper-icons', icon: 'minus' -%}
                      </button>
                      <input id="vpd-qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" aria-label="Quantity">
                      <button type="button" data-qty-step="1" aria-label="Increase quantity">
                        {%- render 'vesper-icons', icon: 'plus' -%}
                      </button>
                    </div>
                  </div>
                </div>

                <input type="hidden" name="id" value="{{ vpd_variant.id }}">
                <button
                  type="submit"
                  class="v-btn v-btn--primary v-btn--block v-btn--lg vpd-add-to-cart"
                  data-add-to-cart
                  data-add-label="Add to Cart — {{ vpd_variant.price | money | strip_html | escape }}"
                  {% unless vpd_variant.available %}disabled{% endunless %}>
                  {%- render 'vesper-icons', icon: 'cart' -%}
                  <span>Add to Cart — {{ vpd_variant.price | money }}</span>
                </button>
              </form>
            {%- endif -%}
          </div>

          {%- if vpd_code != blank -%}
            <div class="vpd-support-links">
              <a class="vpd-support-link" href="#specifications">
                {%- render 'vesper-icons', icon: 'grid' -%}
                <span>View Specifications</span>
              </a>
              <a class="vpd-support-link" href="/pages/contact">
                {%- render 'vesper-icons', icon: 'phone' -%}
                <span>Contact Us</span>
              </a>
              <a class="vpd-support-link" href="/pages/support">
                {%- render 'vesper-icons', icon: 'headset' -%}
                <span>Product Support</span>
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- if product.handle == 'v600' or product.handle == 'v1000' or product.handle == 'vesper-s1-4wd-40' or product.handle == 'vesper-s1-4wd-50' -%}
    <nav class="vpd-anchor-nav" aria-label="Product page sections">
      <div class="v-container">
        <a href="#overview">Overview</a>
        <a href="#specifications">Specifications</a>
        <a href="#faq">FAQ</a>
        <a href="#vpd-quote">Request a quote</a>
      </div>
    </nav>

    <section class="vpd-metrics" aria-label="Product highlights">
      <div class="v-container vpd-metrics__grid">
        {%- if product.handle == 'v600' or product.handle == 'v1000' -%}
          <div class="vpd-metric"><strong>0 m</strong><span>Boundary wire</span></div>
          <div class="vpd-metric"><strong>3</strong><span>AI cameras</span></div>
          <div class="vpd-metric"><strong>1&quot;–3&quot;</strong><span>Cutting height</span></div>
          <div class="vpd-metric"><strong>15 cm</strong><span>Adjustable edge offset</span></div>
        {%- elsif product.handle == 'vesper-s1-4wd-40' -%}
          <div class="vpd-metric"><strong>40°</strong><span>Maximum slope</span></div>
          <div class="vpd-metric"><strong>53 cm</strong><span>Cutting width</span></div>
          <div class="vpd-metric"><strong>1,985 W</strong><span>Peak cutting power</span></div>
          <div class="vpd-metric"><strong>2.25 h</strong><span>Runtime (18Ah)</span></div>
        {%- else -%}
          <div class="vpd-metric"><strong>50°</strong><span>Maximum slope</span></div>
          <div class="vpd-metric"><strong>53 cm</strong><span>Cutting width</span></div>
          <div class="vpd-metric"><strong>1,985 W</strong><span>Peak cutting power</span></div>
          <div class="vpd-metric"><strong>2.25 h</strong><span>Runtime (18Ah)</span></div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- case product.handle -%}
    {%- when 'vesper-s1-4wd-50' -%}
      {% render 'vesper-product-content-vesper-s1-4wd-50', code: 'Mowrator S1 4WD', name: '119% SLOPE(50°)' %}
    {%- when 'vesper-s1-4wd-40' -%}
      {% render 'vesper-product-content-vesper-s1-4wd-40', code: 'Mowrator S1 4WD', name: '85% SLOPE(40°)' %}
    {%- when 'af718' -%}
      {% render 'vesper-product-content-af718', code: 'AF718', name: 'Autosteering System' %}
    {%- when 'af305' -%}
      {% render 'vesper-product-content-af305', code: 'AF305', name: 'Automated Steering System' %}
    {%- when 'isobus' -%}
      {% render 'vesper-product-content-isobus', code: 'ISOBUS', name: 'Terminal' %}
    {%- when 'vs100' -%}
      {% render 'vesper-product-content-vs100', code: 'VS100', name: 'Spray Control System' %}
    {%- when 'w20' -%}
      {% render 'vesper-product-content-w20', code: 'W20', name: 'Land Leveling System' %}
    {%- when 'aries300n' -%}
      {% render 'vesper-product-content-aries300n', code: 'Aries300N', name: 'Orchard Spraying Robot' %}
    {%- when 'taurus80e' -%}
      {% render 'vesper-product-content-taurus80e', code: 'Taurus80E', name: 'Smart Lawn Mowing Robot' %}
    {%- when 'egs101' -%}
      {% render 'vesper-product-content-egs101', code: 'EGS101', name: 'Intelligent Excavator Guidance System' %}
    {%- when 'v600' -%}
      {% render 'vesper-product-content-v600', code: 'TerraMow V600', name: 'Auto Mower' %}
    {%- when 'v1000' -%}
      {% render 'vesper-product-content-v1000', code: 'TerraMow V1000', name: 'Auto Mower' %}
  {%- endcase -%}

  {%- if vpd_code != blank -%}
    <section class="vpd-cta-section" id="vpd-quote">
      <div class="vpd-cta-inner">
        <h2>Interested in {{ vpd_code }} {{ vpd_name }}?</h2>
        <p>Contact us today for more information or request a demo</p>
        <div class="vpd-cta-actions">
          <button type="button" class="v-btn v-btn--pill-primary v-btn--lg" data-request-demo data-whatsapp="{{ vpd_whatsapp }}" data-message="Hello! I'm interested in getting a quote for the {{ vpd_code }} {{ vpd_name }}. Could you please provide more information?">
            {%- render 'vesper-icons', icon: 'whatsapp' -%}
            <span>Get A Quote</span>
          </button>
          <a class="v-btn v-btn--lg vpd-cta-contact" href="/pages/contact">
            <span>Contact Us</span>
          </a>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 移动端底部常驻购买栏：只做锚点与 WhatsApp 跳转，不复制购买表单 {%- endcomment -%}
  {%- if vpd_code != blank -%}
    <div class="vpd-buybar">
      <div class="vpd-buybar__inner">
        <div class="vpd-buybar__meta">
          <span class="vpd-buybar__code">{{ vpd_code }} {{ vpd_name }}</span>
          <span class="vpd-buybar__price">
            {%- if vpd_variant != nil -%}{{ vpd_variant.price | money }}{%- else -%}{{ vpd_price_text }}{%- endif -%}
          </span>
        </div>
        <div class="vpd-buybar__actions">
          <button type="button" class="vpd-buybar__btn vpd-buybar__btn--demo" data-request-demo data-whatsapp="{{ vpd_whatsapp }}" data-message="Hello! I would like to request a demo of the {{ vpd_code }} {{ vpd_name }}.">Get a Demo</button>
          <a class="vpd-buybar__btn vpd-buybar__btn--buy" href="#vpd-buy">Buy Now</a>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Vesper product detail",
  "tag": "section",
  "class": "vesper-product-detail-section",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number (digits only)",
      "default": "61448290926"
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share buttons",
      "default": true
    }
  ]
}
{% endschema %}
