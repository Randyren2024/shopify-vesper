      assign vpd_features = '40° (85%) slope, 10 cm obstacle clearance|53 cm deck, 1985W peak cutting power|2000 ㎡/h coverage, 3× faster|Runtime up to 2.25h (18Ah) / 1.5h (12Ah)|Wide TPU Tread Wheels for max grip|Discharge, Mulch, Bag + Leaf-Shredding Vacuum'
      assign vpd_image = 'products-vesper-s1-4wd-40.webp'
      assign vpd_price_text = '$1,999.00'
      assign vpd_best = 'true'
      assign vpd_new = 'true'
    when 'af718'
      assign vpd_code = 'AF718'
      assign vpd_name = 'Autosteering System'
      assign vpd_category_name = 'Precision Agriculture'
      assign vpd_category_id = 'precision-agriculture'
      assign vpd_tagline = 'AF718 Frontier — Pioneering the Future of Smart Farming'
      assign vpd_badges = 'COLLABORATIVE|EFFICIENT|STABLE|SECURE|ACCURATE|COMPATIBLE|UPGRADABLE'
      assign vpd_why = 'High-performance processor and robust motor system support heavy-duty work and long-duration continuous operation|AI expansion interfaces enable seamless integration of advanced intelligent algorithms and modules|High-precision navigation with automatic path planning and real-time obstacle adjustment|Complete precision agriculture ecosystem supporting spraying, seeding, fertilizing, and more|Multi-machine collaboration enables synchronized operations across multiple vehicles in the same field|Centered on the AF718, supports diverse functions and flexible application across different farmland environments'
      assign vpd_features = 'COLLABORATIVE|EFFICIENT|STABLE|SECURE|ACCURATE|COMPATIBLE|UPGRADABLE'
      assign vpd_image = 'products-af718-main.png'
      assign vpd_price_text = '$3,499.00'
      assign vpd_best = 'true'
      assign vpd_new = 'true'
    when 'af305'
      assign vpd_code = 'AF305'
      assign vpd_name = 'Automated Steering System'
      assign vpd_category_name = 'Precision Agriculture'
      assign vpd_category_id = 'precision-agriculture'
      assign vpd_tagline = 'An Advanced Steering Solution for Precision Agriculture'
      assign vpd_badges = 'EFFICIENT|STABLE|PREMIUM|ACCURATE|UPGRADABLE'
      assign vpd_why = 'The AF305 Automated Steering System uses a high-torque motor control design, combined with a self-developed control algorithm, achieving ±2.5 cm pass-to-pass accuracy|Supports multiple vehicle types with easy 20-minute installation and setup|ISOBUS-compatible for seamless integration with agricultural implements|Advanced correction services provide reliable positioning even in challenging environments|Worry-free autosteering with terrain compensation and intelligent path planning'
      assign vpd_features = 'Advanced GNSS positioning|Auto-steering control|Easy installation (20 min setup)|ISOBUS compatible|Terrain compensation|±2.5 cm accuracy'
      assign vpd_image = 'products-af305-main.png'
      assign vpd_price_text = '$2,199.00'
      assign vpd_best = 'true'
    when 'isobus'
      assign vpd_code = 'ISOBUS'
      assign vpd_name = 'Terminal'
      assign vpd_category_name = 'Precision Agriculture'
      assign vpd_category_id = 'precision-agriculture'
      assign vpd_tagline = 'A one-stop ISOBUS solution for smart implements — fully compatible with mainstream agricultural equipment'
      assign vpd_badges = 'EFFICIENT|STABLE|ACCURATE|UPGRADABLE'
      assign vpd_why = 'One-stop ISOBUS solution fully compatible with mainstream agricultural equipment, empowering universal terminal operations across mixed-brand fleets|12.1-inch high-brightness touchscreen provides clear visibility even in direct sunlight, with intuitive interface for reduced operator training|Built-in high-precision GNSS guidance eliminates the need for separate navigation displays|AEF-certified ISOBUS compliance ensures reliable UT and TC functionality with any ISOBUS-compatible implement|Highly expandable — supports future upgrades and integration with precision agriculture ecosystem'
      assign vpd_features = 'AEF certified|ISOBUS compliant|Multi-brand compatibility|UT and TC support|Built-in GNSS guidance|12.1" sunlight-readable touchscreen'
      assign vpd_image = 'products-isobus-main.png'
      assign vpd_price_text = '$1,299.00'
    when 'vs100'
      assign vpd_code = 'VS100'
      assign vpd_name = 'Spray Control System'
      assign vpd_category_name = 'Precision Agriculture Solutions'
      assign vpd_category_id = 'precision-spraying'
      assign vpd_tagline = 'The VS100 Smart Spray Control System utilizes advanced satellite navigation to deliver precise pest and weed management'
      assign vpd_badges = 'EFFICIENT|STABLE|PREMIUM|ACCURATE|UPGRADABLE'
      assign vpd_why = 'Utilizes advanced satellite navigation and control technology to deliver precise pest and weed management, reducing chemical waste by up to 15%|Section control with up to 16 individual sections ensures precise application, eliminating overlaps and skips even in irregularly shaped fields|Visualized operation interface provides real-time spray data including pressure, flow rate, and coverage maps for complete traceability|High compatibility with major sprayer brands and ISOBUS implements, with easy expansion for additional precision agriculture functions|Reapplication control prevents double-spraying of treated areas, saving chemicals and protecting crop health'
