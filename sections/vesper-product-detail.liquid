{{ 'vesper-product.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Vesper product detail page — ported from
  vesper_vue/src/views/ProductDetailView.vue.

  The commerce column (price / variants / quantity / add to cart) is driven by
  the native Shopify `product` object. Everything else (tagline, feature
  badges, why/features accordion, specs, FAQ, learn-more cards, applications,
  related products) is static content dispatched per handle below.

  Rich content for each handle lives in snippets/vesper-product-content-*.liquid
  and is pulled in with an explicit `case` because `render` needs a literal
  snippet name and cannot take a variable.
{%- endcomment -%}

{%- liquid
  assign vpd_code = ''
  assign vpd_name = ''
  assign vpd_category_name = ''
  assign vpd_category_id = ''
  assign vpd_tagline = ''
  assign vpd_badges = ''
  assign vpd_why = ''
  assign vpd_features = ''
  assign vpd_image = ''
  assign vpd_price_text = ''
  assign vpd_best = 'false'
  assign vpd_new = 'false'

  case product.handle
    when 'vesper-s1-4wd-50'
      assign vpd_code = 'Mowrator S1 4WD'
      assign vpd_name = '119% SLOPE(50°)'
      assign vpd_category_name = 'Lawn Mower'
      assign vpd_category_id = 'lawn-mower'
      assign vpd_tagline = 'Remember the joy of RC cars as a kid? We brought that feeling back to your lawn.'
