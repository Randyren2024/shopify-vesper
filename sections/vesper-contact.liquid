{{ 'vesper-contact.css' | asset_url | stylesheet_tag }}

{% render 'vesper-page-hero',
   title: 'Contact Us',
   subtitle: 'Questions about our robot mowers, an order, a return or a warranty claim?',
   breadcrumb: 'Contact Us' %}

{%- liquid
  assign contact_cards = section.blocks | where: 'type', 'contact_card'
-%}

<div class="vesper-contact">
  <section class="vcp-section">
    <div class="v-container">
      <div class="vcp-layout">
        <aside class="vcp-aside" data-reveal="left">
          <p class="vcp-eyebrow">Get in touch</p>
          <h2 class="vcp-heading">{{ section.settings.info_heading }}</h2>
          <p class="vcp-sub">{{ section.settings.info_subtitle }}</p>

          <ul class="vcp-list">
            {%- for block in contact_cards -%}
              {%- liquid
                assign card_icon = ''
                case block.settings.icon
                  when 'phone'
                    assign card_icon = 'phone'
                  when 'mail'
                    assign card_icon = 'mail'
                  when 'map-pin'
                    assign card_icon = 'map-pin'
                  when 'whatsapp'
                    assign card_icon = 'whatsapp'
                endcase

                if card_icon == blank
                  case block.settings.tone
                    when 'phone'
                      assign card_icon = 'phone'
                    when 'email'
                      assign card_icon = 'mail'
                    when 'whatsapp'
                      assign card_icon = 'whatsapp'
                    when 'location'
                      assign card_icon = 'map-pin'
                    else
                      assign card_icon = 'phone'
                  endcase
                endif
              -%}

              <li class="vcp-item" {{ block.shopify_attributes }}>
                <span class="vcp-item__icon">
                  {%- render 'vesper-icons', icon: card_icon -%}
                </span>

                <div class="vcp-item__body">
                  <span class="vcp-item__label">{{ block.settings.title }}</span>
                  <span class="vcp-item__value">{{ block.settings.content }}</span>
                  {%- if block.settings.subtext != blank -%}
                    <span class="vcp-item__note">{{ block.settings.subtext }}</span>
                  {%- endif -%}
                </div>

                {%- case block.settings.action_type -%}
                  {%- when 'tel' -%}
                    <a class="vcp-item__link" href="tel:{{ block.settings.action_value | remove: ' ' }}">
                      <span>{{ block.settings.action_label }}</span>
                      {%- render 'vesper-icons', icon: 'arrow-right' -%}
                    </a>
                  {%- when 'mailto' -%}
                    <a class="vcp-item__link" href="mailto:{{ block.settings.action_value }}">
                      <span>{{ block.settings.action_label }}</span>
                      {%- render 'vesper-icons', icon: 'arrow-right' -%}
                    </a>
                  {%- when 'whatsapp' -%}
                    <a class="vcp-item__link" href="https://wa.me/{{ block.settings.action_value }}?text={{ 'Hello! I would like to get in touch with Vesper Robot Mowers.' | url_encode }}" target="_blank" rel="noopener">
                      <span>{{ block.settings.action_label }}</span>
                      {%- render 'vesper-icons', icon: 'arrow-right' -%}
                    </a>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>

          <dl class="vcp-facts">
            <div class="vcp-facts__row">
              <dt>{{ section.settings.hours_label }}</dt>
              <dd>{{ section.settings.hours_value }}</dd>
            </div>
            <div class="vcp-facts__row">
              <dt>{{ section.settings.entity_label }}</dt>
              <dd>{{ section.settings.entity_value }}</dd>
            </div>
            <div class="vcp-facts__row">
              <dt>{{ section.settings.social_label }}</dt>
              <dd class="vcp-facts__links">
                <a href="https://www.linkedin.com/company/vesperinno" target="_blank" rel="noopener noreferrer">{{ section.settings.social_1 }}</a>
                <a href="https://www.facebook.com/share/1JWNgbRVk2/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">{{ section.settings.social_2 }}</a>
                <a href="https://www.tiktok.com/@vesper.inno2020?_r=1&amp;_t=ZS-955nk6Azn5Z" target="_blank" rel="noopener noreferrer">{{ section.settings.social_3 }}</a>
              </dd>
            </div>
          </dl>
        </aside>

        {%- comment -%} Contact form (native Shopify contact form) {%- endcomment -%}
        <div class="vcp-form" data-reveal="right" data-lead-form="contact_page">
          <header class="vcp-form__head">
            <h2 class="vcp-form__title">{{ section.settings.form_heading }}</h2>
            <p class="vcp-form__sub">{{ section.settings.form_subtitle }}</p>
          </header>

          {%- form 'contact' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-success" role="status" data-lead-success data-lead-form="contact_page" data-lead-product="{{ form.product | escape }}">{{ section.settings.form_success }}</p>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
            {%- endif -%}

            <div class="vcp-grid">
              <div class="v-field">
                <label class="v-field__label" for="contact-name">Full Name *</label>
                <input
                  id="contact-name"
                  class="v-input"
                  type="text"
                  name="contact[name]"
                  value="{{ form.name }}"
                  placeholder="Enter your full name"
                  autocomplete="name"
                  required
                >
              </div>

              <div class="v-field">
                <label class="v-field__label" for="contact-email">Email Address *</label>
                <input
                  id="contact-email"
                  class="v-input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="Enter your email address"
                  autocomplete="email"
                  required
                >
              </div>

              <div class="v-field">
                <label class="v-field__label" for="contact-phone">Phone Number</label>
                <input
                  id="contact-phone"
                  class="v-input"
                  type="tel"
                  name="contact[phone]"
                  value="{{ form.phone }}"
                  placeholder="Enter your phone number"
                  autocomplete="tel"
                >
              </div>

              <div class="v-field">
                <label class="v-field__label" for="contact-company">Company</label>
                <input id="contact-company" class="v-input" type="text" name="contact[company]" value="{{ form.company | escape }}" placeholder="Company name" autocomplete="organization">
              </div>

              <div class="v-field">
                <label class="v-field__label" for="contact-product">Product Interest</label>
                <select id="contact-product" class="v-select" name="contact[product]">
                  <option value="">Select a product or category</option>
                  <optgroup label="Lawn Mower">
                    <option value="S1 4WD 50° - Remote Control Lawn Mower — 119% Slope (Grip Tread)">S1 4WD 50° - Remote Control Lawn Mower — 119% Slope (Grip Tread)</option>
                    <option value="S1 4WD 40° - Remote Control Lawn Mower — 85% Slope (Wide Wheel)">S1 4WD 40° - Remote Control Lawn Mower — 85% Slope (Wide Wheel)</option>
                    <option value="V600 - TerraMow Auto Mower">V600 - TerraMow Auto Mower</option>
                    <option value="V1000 - TerraMow Auto Mower">V1000 - TerraMow Auto Mower</option>
                  </optgroup>
                  <optgroup label="Precision Agriculture">
                    <option value="AF718 - Autosteering System">AF718 - Autosteering System</option>
                    <option value="AF305 - Automated Steering System">AF305 - Automated Steering System</option>
                    <option value="ISOBUS - Terminal">ISOBUS - Terminal</option>
                  </optgroup>
                  <optgroup label="Precision Agriculture Solutions">
                    <option value="VS100 - Spray Control System">VS100 - Spray Control System</option>
                  </optgroup>
                  <optgroup label="Land Leveling System">
                    <option value="W20 - Land Leveling System">W20 - Land Leveling System</option>
                  </optgroup>
                  <optgroup label="Machine Control">
                    <option value="EGS101 - Intelligent Excavator Guidance System">EGS101 - Intelligent Excavator Guidance System</option>
                  </optgroup>
                  <optgroup label="Agricultural Robots">
                    <option value="Aries300N - Orchard Spraying Robot">Aries300N - Orchard Spraying Robot</option>
                    <option value="Taurus80E - Smart Lawn Mowing Robot">Taurus80E - Smart Lawn Mowing Robot</option>
                  </optgroup>
                </select>
              </div>

              <div class="v-field vcp-grid__full">
                <label class="v-field__label" for="contact-message">Message *</label>
                <textarea
                  id="contact-message"
                  class="v-textarea"
                  name="contact[body]"
                  rows="6"
                  placeholder="Tell us about your needs or questions..."
                  required
                >{{ form.body }}</textarea>
              </div>
            </div>

            <div class="vcp-form__actions">
              <button type="submit" class="v-btn v-btn--primary v-btn--lg submit-btn">Send message</button>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Vesper contact",
  "settings": [
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Heading",
      "default": "Contact Information"
    },
    {
      "type": "text",
      "id": "info_subtitle",
      "label": "Subtitle",
      "default": "Send us a message and we will get back to you within 1 business day."
    },
    {
      "type": "header",
      "content": "Contact form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Heading",
      "default": "Send Us a Message"
    },
    {
      "type": "textarea",
      "id": "form_subtitle",
      "label": "Subtitle",
      "default": "Fill out the form below and we'll get back to you as soon as possible"
    },
    {
      "type": "text",
      "id": "form_success",
      "label": "Success message",
      "default": "Thanks! Your message has been sent. We'll get back to you as soon as possible."
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Business hours label",
      "default": "Business hours"
    },
    {
      "type": "text",
      "id": "hours_value",
      "label": "Business hours",
      "default": "Mon–Fri 9:00 am – 5:00 pm (AEST/AEDT)"
    },
    {
      "type": "text",
      "id": "entity_label",
      "label": "Company label",
      "default": "Company"
    },
    {
      "type": "text",
      "id": "entity_value",
      "label": "Company",
      "default": "Vesper Robot Mowers Pty. Ltd. ABN 71702120143"
    },
    {
      "type": "text",
      "id": "social_label",
      "label": "Social label",
      "default": "Follow us"
    },
    {
      "type": "text",
      "id": "social_1",
      "label": "Social link 1",
      "default": "LinkedIn"
    },
    {
      "type": "text",
      "id": "social_2",
      "label": "Social link 2",
      "default": "Facebook"
    },
    {
      "type": "text",
      "id": "social_3",
      "label": "Social link 3",
      "default": "TikTok"
    }
  ],
  "blocks": [
    {
      "type": "contact_card",
      "name": "Contact card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name (optional)",
          "info": "phone, mail, map-pin or whatsapp. Leave empty to use the icon colour."
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Icon",
          "options": [
            { "value": "phone", "label": "Phone" },
            { "value": "email", "label": "Email" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "location", "label": "Location" }
          ],
          "default": "phone"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "select",
          "id": "action_type",
          "label": "Action",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "tel", "label": "Phone call" },
            { "value": "mailto", "label": "Email" },
            { "value": "whatsapp", "label": "WhatsApp" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "action_value",
          "label": "Action value",
          "info": "Phone number or email address"
        },
        {
          "type": "text",
          "id": "action_label",
          "label": "Action label"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        }
      ]
    }
  ]
}
{% endschema %}
