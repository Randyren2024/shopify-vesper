{{ 'vesper-contact.css' | asset_url | stylesheet_tag }}

{% render 'vesper-page-hero',
   title: 'Contact Us',
   subtitle: 'Questions about our robot mowers, an order, a return or a warranty claim?',
   breadcrumb: 'Contact Us' %}

{%- liquid
  assign contact_cards = section.blocks | where: 'type', 'contact_card'
-%}

<div class="vesper-contact">
  <div class="vesper-contact__lead-wrap">
    <div class="v-container">
      <p class="vesper-contact__lead" data-reveal>Get In Touch</p>
    </div>
  </div>

  {%- comment -%} Contact information cards {%- endcomment -%}
  <section class="contact-info-section v-section">
    <div class="v-container">
      <div class="v-section-head" data-reveal>
        <h2 class="gradient-text-secondary">{{ section.settings.info_heading }}</h2>
        <p>{{ section.settings.info_subtitle }}</p>
      </div>

      <div class="contact-cards">
        {%- for block in contact_cards -%}
          <div class="contact-card v-card v-card-hover" data-reveal {{ block.shopify_attributes }}>
            <div class="contact-icon contact-icon--{{ block.settings.tone }}">
              <span>{{ block.settings.icon }}</span>
            </div>
            <h3 class="contact-card-title">{{ block.settings.title }}</h3>
            <p class="contact-card-content">{{ block.settings.content }}</p>

            {%- case block.settings.action_type -%}
              {%- when 'tel' -%}
                <a class="v-btn v-btn--primary v-btn--sm contact-action-btn" href="tel:{{ block.settings.action_value | remove: ' ' }}">{{ block.settings.action_label }}</a>
              {%- when 'mailto' -%}
                <a class="v-btn v-btn--primary v-btn--sm contact-action-btn" href="mailto:{{ block.settings.action_value }}">{{ block.settings.action_label }}</a>
              {%- when 'whatsapp' -%}
                <a class="v-btn v-btn--primary v-btn--sm contact-action-btn" href="https://wa.me/{{ block.settings.action_value }}?text={{ 'Hello! I would like to get in touch with Vesper Robot Mowers.' | url_encode }}" target="_blank" rel="noopener">{{ block.settings.action_label }}</a>
            {%- endcase -%}

            {%- if block.settings.subtext != blank -%}
              <p class="contact-card-subtext">{{ block.settings.subtext }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="contact-meta" data-reveal>
        <div class="contact-meta__item">
          <span class="contact-meta__label">{{ section.settings.hours_label }}</span>
          <span class="contact-meta__value">{{ section.settings.hours_value }}</span>
        </div>

        <div class="contact-meta__item">
          <span class="contact-meta__label">{{ section.settings.entity_label }}</span>
          <span class="contact-meta__value">{{ section.settings.entity_value }}</span>
        </div>

        <div class="contact-meta__item">
          <span class="contact-meta__label">{{ section.settings.social_label }}</span>
          <span class="contact-meta__value contact-meta__social">
            <a href="https://www.linkedin.com/company/vesperinno" target="_blank" rel="noopener noreferrer">{{ section.settings.social_1 }}</a>
            <a href="https://www.facebook.com/share/1JWNgbRVk2/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer">{{ section.settings.social_2 }}</a>
            <a href="https://www.tiktok.com/@vesper.inno2020?_r=1&_t=ZS-955nk6Azn5Z" target="_blank" rel="noopener noreferrer">{{ section.settings.social_3 }}</a>
          </span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Contact form (native Shopify contact form) {%- endcomment -%}
  <section class="contact-form-section v-section">
    <div class="v-container">
      <div class="form-container">
        <div class="form-header" data-reveal>
          <h2 class="form-title">{{ section.settings.form_heading }}</h2>
          <p class="form-subtitle">{{ section.settings.form_subtitle }}</p>
        </div>

        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success" role="status">{{ section.settings.form_success }}</p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="form-content">
            <div class="form-row">
              <div class="v-field">
                <label class="v-field__label" for="contact-name">Full Name *</label>
                <input
                  id="contact-name"
                  class="v-input"
                  type="text"
                  name="contact[name]"
                  value="{{ form.name }}"
                  placeholder="Enter your full name"
                  required
                >
              </div>

              <div class="v-field">
                <label class="v-field__label" for="contact-email">Email Address *</label>
                <input
                  id="contact-email"
                  class="v-input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="Enter your email address"
                  required
                >
              </div>
            </div>

            <div class="form-row">
              <div class="v-field">
                <label class="v-field__label" for="contact-phone">Phone Number</label>
                <input
                  id="contact-phone"
                  class="v-input"
                  type="tel"
                  name="contact[phone]"
                  value="{{ form.phone }}"
                  placeholder="Enter your phone number"
                >
              </div>

              <div class="v-field">
                <label class="v-field__label" for="contact-product">Product Interest</label>
                <select id="contact-product" class="v-select" name="contact[product]">
                  <option value="">Select a product or category</option>
                  <optgroup label="Lawn Mower">
                    <option value="S1 4WD 50° - Remote Control Lawn Mower — 119% Slope (Grip Tread)">S1 4WD 50° - Remote Control Lawn Mower — 119% Slope (Grip Tread)</option>
                    <option value="S1 4WD 40° - Remote Control Lawn Mower — 85% Slope (Wide Wheel)">S1 4WD 40° - Remote Control Lawn Mower — 85% Slope (Wide Wheel)</option>
                  </optgroup>
                  <optgroup label="Precision Agriculture">
                    <option value="AF718 - Autosteering System">AF718 - Autosteering System</option>
                    <option value="AF305 - Automated Steering System">AF305 - Automated Steering System</option>
                    <option value="ISOBUS - Terminal">ISOBUS - Terminal</option>
                  </optgroup>
                  <optgroup label="Precision Agriculture Solutions">
                    <option value="VS100 - Spray Control System">VS100 - Spray Control System</option>
                  </optgroup>
                  <optgroup label="Land Leveling System">
                    <option value="W20 - Land Leveling System">W20 - Land Leveling System</option>
                  </optgroup>
                  <optgroup label="Machine Control">
                    <option value="EGS101 - Intelligent Excavator Guidance System">EGS101 - Intelligent Excavator Guidance System</option>
                  </optgroup>
                </select>
              </div>
            </div>

            <div class="v-field">
              <label class="v-field__label" for="contact-message">Message *</label>
              <textarea
                id="contact-message"
                class="v-textarea"
                name="contact[body]"
                rows="6"
                placeholder="Tell us about your needs or questions..."
                required
              >{{ form.body }}</textarea>
            </div>

            <div class="form-actions">
              <button type="submit" class="v-btn v-btn--primary v-btn--lg submit-btn">Send message</button>
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Vesper contact",
  "settings": [
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Heading",
      "default": "Contact Information"
    },
    {
      "type": "text",
      "id": "info_subtitle",
      "label": "Subtitle",
      "default": "Send us a message and we will get back to you within 1 business day."
    },
    {
      "type": "header",
      "content": "Contact form"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Heading",
      "default": "Send Us a Message"
    },
    {
      "type": "textarea",
      "id": "form_subtitle",
      "label": "Subtitle",
      "default": "Fill out the form below and we'll get back to you as soon as possible"
    },
    {
      "type": "text",
      "id": "form_success",
      "label": "Success message",
      "default": "Thanks! Your message has been sent. We'll get back to you as soon as possible."
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Business hours label",
      "default": "Business hours"
    },
    {
      "type": "text",
      "id": "hours_value",
      "label": "Business hours",
      "default": "Mon–Fri 9:00 am – 5:00 pm (AEST/AEDT)"
    },
    {
      "type": "text",
      "id": "entity_label",
      "label": "Company label",
      "default": "Company"
    },
    {
      "type": "text",
      "id": "entity_value",
      "label": "Company",
      "default": "Vesper Robot Mowers Pty. Ltd. ABN 71702120143"
    },
    {
      "type": "text",
      "id": "social_label",
      "label": "Social label",
      "default": "Follow us"
    },
    {
      "type": "text",
      "id": "social_1",
      "label": "Social link 1",
      "default": "LinkedIn"
    },
    {
      "type": "text",
      "id": "social_2",
      "label": "Social link 2",
      "default": "Facebook"
    },
    {
      "type": "text",
      "id": "social_3",
      "label": "Social link 3",
      "default": "TikTok"
    }
  ],
  "blocks": [
    {
      "type": "contact_card",
      "name": "Contact card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Icon colour",
          "options": [
            { "value": "phone", "label": "Blue" },
            { "value": "email", "label": "Yellow" },
            { "value": "whatsapp", "label": "Green" },
            { "value": "location", "label": "Purple" }
          ],
          "default": "phone"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "select",
          "id": "action_type",
          "label": "Action",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "tel", "label": "Phone call" },
            { "value": "mailto", "label": "Email" },
            { "value": "whatsapp", "label": "WhatsApp" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "action_value",
          "label": "Action value",
          "info": "Phone number or email address"
        },
        {
          "type": "text",
          "id": "action_label",
          "label": "Action label"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        }
      ]
    }
  ]
}
{% endschema %}
