<footer class="site-footer">
  <div class="v-container site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <img
          class="site-footer__logo"
          alt="{{ shop.name | escape }}"
          src="{{ 'vesper-logo-white.svg' | asset_url }}"
          width="557"
          height="83"
        >

        <p
          class="site-footer__tagline"
        >{{ section.settings.tagline }}</p>

        <div class="site-footer__socials">
          {%- for i in (1..3) -%}
            {%- case i -%}
              {%- when 1 -%}
                {%- assign social = section.settings.social_1 -%}
                {%- assign social_url = 'https://www.tiktok.com/@vesper.inno2020?_r=1&_t=ZS-955nk6Azn5Z' -%}
              {%- when 2 -%}
                {%- assign social = section.settings.social_2 -%}
                {%- assign social_url = 'https://www.linkedin.com/company/vesperinno' -%}
              {%- when 3 -%}
                {%- assign social = section.settings.social_3 -%}
                {%- assign social_url = 'https://www.facebook.com/share/1JWNgbRVk2/?mibextid=wwXIfr' -%}
            {%- endcase -%}

            {%- if social != blank -%}
              <a
                href="{{ social_url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="site-footer__social-link"
              >{{ social }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div>
        <div
          class="site-footer__heading"
        >{{ section.settings.products_heading }}</div>

        {%- assign items = section.settings.products_items | newline_to_br | split: '<br />' -%}

        {%- for item in items -%}
          {%- if item != blank -%}
            <div
              class="site-footer__link"
            >{{ item | strip }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div>
        <div
          class="site-footer__heading"
        >{{ section.settings.company_heading }}</div>

        {%- assign items = section.settings.company_items | newline_to_br | split: '<br />' -%}

        {%- for item in items -%}
          {%- if item != blank -%}
            {%- assign item_parts = item | strip | split: '|' -%}
            {%- assign item_label = item_parts[0] | strip -%}
            {%- assign item_link = item_parts[1] | strip -%}
            {%- if item_link != blank -%}
              <a
                href="{{ item_link }}"
                class="site-footer__link"
              >{{ item_label }}</a>
            {%- else -%}
              <div
                class="site-footer__link"
              >{{ item_label }}</div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <div
          class="site-footer__heading site-footer__heading--secondary"
        >{{ section.settings.legal_heading }}</div>

        {%- assign legal_links = section.settings.legal_more | newline_to_br | split: '<br />' -%}

        {%- for row in legal_links -%}
          {%- if row != blank -%}
            {%- assign row_parts = row | strip | split: '|' -%}
            {%- assign row_label = row_parts[0] | strip -%}
            {%- assign row_link = row_parts[1] | strip -%}
            {%- if row_link != blank -%}
              <a
                href="{{ row_link }}"
                class="site-footer__link"
              >{{ row_label }}</a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div>
        <div
          class="site-footer__heading"
        >{{ section.settings.contact_heading }}</div>

        {%- assign items = section.settings.contact_items | newline_to_br | split: '<br />' -%}

        {%- for item in items -%}
          {%- if item != blank -%}
            <div
              class="site-footer__link"
            >{{ item | strip }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div
      class="site-footer__bottom"
    >
      <div
        class="site-footer__bottom-inner"
      >
        <div
          class="site-footer__copyright"
        >{{ section.settings.copyright }}</div>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="v-payment-icons" aria-label="Accepted payment methods">
            {%- for type in shop.enabled_payment_types -%}
              <li class="v-payment-icons__item">{{ type | payment_type_svg_tag: class: 'v-payment-icons__svg' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{%- comment -%} 产品页底部由 .vpd-buybar 承担转化，避免两条固定底栏叠在一起 {%- endcomment -%}
{%- if section.settings.mobile_cta_label != blank and template.name != 'product' -%}
  <div class="fixed bottom-0 left-0 right-0 z-40 md:hidden">
    <a
      href="{{ section.settings.mobile_cta_link }}"
      style="display: flex; align-items: center; justify-content: center; background: rgb(17, 17, 16); color: rgb(248, 247, 244); font-family: Barlow, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; padding: 15px 0px; text-transform: uppercase;"
    >{{ section.settings.mobile_cta_label }}</a>
  </div>

  <div class="h-14 md:h-0"></div>
{%- endif -%}

