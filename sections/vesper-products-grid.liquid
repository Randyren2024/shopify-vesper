{%- comment -%}
  Products & Solutions — product grid.

  Lists the products published in the store (`collections.all`). Products no
  longer use categories, so only the "All" filter tab is shown.
{%- endcomment -%}

{%- liquid
  assign page_path = page.url | default: request.path
-%}

<section class="v-products-filter">
  <div class="v-container">
    <nav class="v-products-filter__tabs" aria-label="Product categories">
      <a class="v-products-filter__tab is-active" href="{{ page_path }}">All</a>
    </nav>
  </div>
</section>

<section class="v-products-grid">
  <div class="v-container">
    <div class="v-products-grid__inner">
      {%- for product in collections.all.products -%}
        {%- assign p_best = false -%}
        {%- if product.tags contains 'Best Seller' -%}
          {%- assign p_best = true -%}
        {%- endif -%}
        {%- assign p_new = false -%}
        {%- if product.tags contains 'New' -%}
          {%- assign p_new = true -%}
        {%- endif -%}
        {%- render 'vesper-product-card',
          product: product,
          category_name: product.type,
          bestseller: p_best,
          is_new: p_new -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="v-products-cta">
  <div class="v-container">
    <h2>Ready to Transform Your Farming?</h2>
    <p>Contact us today for a personalized demonstration or quote</p>
    <div class="v-products-cta__actions">
      <button type="button" class="v-btn v-btn--lg v-products-cta__primary" data-request-demo>Request a Demo</button>
      <a class="v-btn v-btn--lg v-products-cta__outline" href="/pages/contact">Contact Us</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Products grid",
  "tag": "div",
  "class": "vesper-products-grid-section",
  "settings": [],
  "presets": [
    {
      "name": "Products grid"
    }
  ]
}
{% endschema %}
