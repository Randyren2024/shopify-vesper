<section id="cta" class="py-24 md:py-32" style="background: rgb(30, 61, 30);">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h2
      class="text-[40px] md:text-[64px] uppercase tracking-tight mb-5 max-w-2xl mx-auto"
      style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 700; color: rgb(248, 247, 244); line-height: 1;"
    >{{ section.settings.heading }}</h2>

    <p
      style="font-family: Barlow, sans-serif; font-size: 16px; color: rgba(248, 247, 244, 0.6); line-height: 1.7; max-width: 400px; margin: 0px auto 40px;"
    >{{ section.settings.body }}</p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      {%- if section.settings.primary_label != blank -%}
        <a
          href="{{ section.settings.primary_link }}"
          class="hover:bg-[#EEECEA] transition-colors uppercase"
          style="background: rgb(248, 247, 244); color: rgb(17, 17, 16); font-family: Barlow, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; padding: 14px 32px; display: inline-block;"
        >{{ section.settings.primary_label }}</a>
      {%- endif -%}

      {%- if section.settings.secondary_label != blank -%}
        <a
          href="{{ section.settings.secondary_link }}"
          class="hover:border-white transition-colors uppercase"
          style="border: 1px solid rgba(248, 247, 244, 0.3); color: rgb(248, 247, 244); font-family: Barlow, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; padding: 14px 32px; display: inline-block;"
        >{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to action",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not Sure What Fits Your Home?"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Come see the robots work. Talk to our team. Find the right solution."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Book a Free Demo"
    },
    {
      "type": "text",
      "id": "primary_link",
      "label": "Primary button link",
      "info": "A URL or an anchor such as #demo",
      "default": "#demo"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Visit Us in Melbourne East"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Secondary button link",
      "info": "A URL or an anchor such as #demo"
    }
  ],
  "presets": [
    {
      "name": "Call to action"
    }
  ]
}
{% endschema %}
