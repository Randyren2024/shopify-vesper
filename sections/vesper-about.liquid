{{ 'vesper-about.css' | asset_url | stylesheet_tag }}

{% render 'vesper-page-hero',
   title: 'About Us',
   subtitle: 'Your trusted partner for advanced agricultural robotics solutions',
   breadcrumb: 'About Us' %}

{%- liquid
  assign journey_items = section.blocks | where: 'type', 'journey_item'
  assign team_members = section.blocks | where: 'type', 'team_member'
  assign value_items = section.blocks | where: 'type', 'value'
  assign stat_items = section.blocks | where: 'type', 'stat'
-%}

<div class="vesper-about">
  <div class="vesper-about__lead-wrap">
    <div class="v-container">
      <p class="vesper-about__lead" data-reveal>Bridging China's Intelligent Hardware Technology with Australia Agriculture</p>
    </div>
  </div>

  {%- comment -%} Company introduction {%- endcomment -%}
  <section class="intro-section v-section">
    <div class="v-container">
      <div class="v-section-head" data-reveal>
        <h2 class="gradient-text-secondary">{{ section.settings.intro_heading }}</h2>
        <p>{{ section.settings.intro_subtitle }}</p>
      </div>

      <div class="intro-content">
        <div class="intro-text" data-reveal="left">
          {{ section.settings.intro_body }}
        </div>

        {%- if section.settings.intro_image != blank -%}
          <div class="intro-image" data-reveal="right">
            <img
              src="{{ section.settings.intro_image | asset_url }}"
              alt="{{ section.settings.intro_image_alt | escape }}"
              loading="lazy"
            >
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} Company journey timeline {%- endcomment -%}
  <section class="timeline-section v-section">
    <div class="v-container">
      <div class="v-section-head" data-reveal>
        <h2 class="gradient-text-secondary">{{ section.settings.journey_heading }}</h2>
        <p>{{ section.settings.journey_subtitle }}</p>
      </div>

      <div class="timeline">
        {%- for block in journey_items -%}
          <div class="timeline-item" data-reveal {{ block.shopify_attributes }}>
            <div class="timeline-logo">
              {%- if block.settings.logo_asset != blank -%}
                <img
                  src="{{ block.settings.logo_asset | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                {% render 'vesper-icons', icon: 'grid' %}
              {%- endif -%}
            </div>
            <div class="timeline-year">{{ block.settings.year }}</div>
            <div class="timeline-content">
              <h3 class="timeline-title">{{ block.settings.title }}</h3>
              <p class="timeline-description">{{ block.settings.description }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} Leadership team {%- endcomment -%}
  <section class="team-section v-section">
    <div class="v-container">
      <div class="v-section-head" data-reveal>
        <h2 class="gradient-text-secondary">{{ section.settings.team_heading }}</h2>
        <p>{{ section.settings.team_subtitle }}</p>
      </div>

      <div class="team-grid">
        {%- for block in team_members -%}
          <div class="team-card v-card" data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.photo_asset != blank -%}
              <div class="team-image">
                <img
                  src="{{ block.settings.photo_asset | asset_url }}"
                  alt="{{ block.settings.photo_alt | escape }}"
                  loading="lazy"
                >
              </div>
            {%- endif -%}
            <div class="team-info">
              <h3 class="team-name">{{ block.settings.name }}</h3>
              <p class="team-position">{{ block.settings.position }}</p>
              <div class="team-bio">{{ block.settings.bio }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} Core values {%- endcomment -%}
  <section class="values-section v-section">
    <div class="v-container">
      <div class="v-section-head" data-reveal>
        <h2 class="gradient-text-secondary">{{ section.settings.values_heading }}</h2>
        <p>{{ section.settings.values_subtitle }}</p>
      </div>

      <div class="values-grid">
        {%- for block in value_items -%}
          <div class="value-card v-card-hover" data-reveal {{ block.shopify_attributes }}>
            <div class="value-icon value-{{ forloop.index }}">{{ block.settings.icon }}</div>
            <h3 class="value-title">{{ block.settings.title }}</h3>
            <p class="value-description">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} Statistics {%- endcomment -%}
  <section class="stats-section v-section">
    <div class="v-container">
      <div class="v-section-head" data-reveal>
        <h2 class="gradient-text-secondary">{{ section.settings.stats_heading }}</h2>
        <p>{{ section.settings.stats_subtitle }}</p>
      </div>

      <div class="stats-grid">
        {%- for block in stat_items -%}
          <div class="stat-card v-card-hover" data-reveal {{ block.shopify_attributes }}>
            <div class="stat-icon">{{ block.settings.icon }}</div>
            <h3 class="stat-title">{{ block.settings.title }}</h3>
            <p class="stat-description">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} Contact CTA {%- endcomment -%}
  <section class="contact-section v-section">
    <div class="v-container">
      <div class="contact-content" data-reveal>
        <h2 class="contact-title">{{ section.settings.cta_heading }}</h2>
        <p class="contact-description">{{ section.settings.cta_description }}</p>

        <div class="contact-actions">
          <a class="v-btn v-btn--primary v-btn--lg" href="/pages/contact-us">{{ section.settings.contact_button_label }}</a>
          <button
            type="button"
            class="v-btn v-btn--outline v-btn--lg"
            data-request-demo
            data-whatsapp="{{ section.settings.whatsapp_number }}"
            data-message="{{ section.settings.demo_message | escape }}"
          >{{ section.settings.demo_label }}</button>
        </div>

        <div class="contact-info">
          <p class="contact-detail">📧 market@vesperinno.com</p>
          <p class="contact-detail">📞 +61 448 290 926</p>
          <p class="contact-detail">📍 Australia</p>
        </div>
      </div>
    </div>
  </section>
</div>

