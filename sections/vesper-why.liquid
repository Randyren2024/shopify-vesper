<section id="why-vesper" class="py-24 md:py-32" style="background: rgb(248, 247, 244);">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-start">
      <div>
        <p
          class="uppercase mb-8"
          style="font-family: Barlow, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; color: rgb(107, 107, 104);"
        >{{ section.settings.eyebrow }}</p>

        <h2
          class="text-[36px] md:text-[52px] uppercase tracking-tight mb-8"
          style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 700; color: rgb(17, 17, 16); line-height: 1;"
        >{{ section.settings.heading }}</h2>

        <p
          class="mb-10"
          style="font-family: Barlow, sans-serif; font-size: 16px; color: rgb(107, 107, 104); line-height: 1.7; max-width: 440px;"
        >{{ section.settings.body }}</p>

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link }}"
            class="hover:bg-[#1E3D1E] transition-colors uppercase"
            style="background: rgb(17, 17, 16); color: rgb(248, 247, 244); font-family: Barlow, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; padding: 13px 24px; display: inline-block;"
          >{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>

      <div style="border-top: 1px solid rgba(17, 17, 16, 0.1);">
        {%- for block in section.blocks -%}
          <div
            style="border-bottom: 1px solid rgba(17, 17, 16, 0.1); padding: 20px 0px;"
            {{ block.shopify_attributes }}
          >
            <h3
              style="font-family: Barlow, sans-serif; font-weight: 700; font-size: 14px; color: rgb(17, 17, 16); letter-spacing: 0.02em; text-transform: uppercase; margin-bottom: 6px;"
            >{{ block.settings.title }}</h3>
            <p
              style="font-family: Barlow, sans-serif; font-size: 14px; color: rgb(107, 107, 104); line-height: 1.6;"
            >{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Vesper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Vesper"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are allowed",
      "default": "Robotics Expertise.<br>Local Support."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "We understand the technology from the inside — and we explain it in a way that helps you make the right decision for your home."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Talk to the Team"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "A URL or an anchor such as #demo",
      "default": "#demo"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Vesper"
    }
  ]
}
{% endschema %}
