{%- comment -%}
  Featured Products — ported from HomeView.vue `.products-section`
  (source data: `getBestSellers().slice(0, 3)` from src/data/products.ts).
  "Get Quote" opens WhatsApp with the same message template as the Vue version.
{%- endcomment -%}

{%- liquid
  assign whatsapp_number = section.settings.whatsapp_number | default: '61448290926'
-%}

<section class="vhome-products v-section">
  <div class="v-container">
    <div class="v-section-head vhome-section-head" data-reveal>
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
    </div>

    <div class="vhome-grid vhome-grid--products">
      {%- for block in section.blocks -%}
        {%- capture quote_message -%}
          Hello! I'm interested in getting a quote for the {{ block.settings.title }}. Could you please provide more information?
        {%- endcapture -%}

        <article class="v-card v-card-hover vhome-product-card" data-reveal {{ block.shopify_attributes }}>
          <a class="vhome-product-card__cover" href="{{ block.settings.link }}" tabindex="-1" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: widths: '320, 480, 640, 800', alt: block.settings.title, loading: 'lazy'
              }}
            {%- elsif block.settings.image_asset != blank -%}
              <img
                src="{{ block.settings.image_asset | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                width="800"
                height="800"
                loading="lazy"
              >
            {%- endif -%}
          </a>

          <div class="vhome-product-card__body">
            <h3 class="vhome-product-card__title">
              <a href="{{ block.settings.link }}">{{ block.settings.title }}</a>
            </h3>
            <p class="vhome-product-card__desc">{{ block.settings.description }}</p>

            <div class="vhome-product-card__actions">
              <a class="v-btn v-btn--primary v-btn--sm" href="{{ block.settings.link }}">Learn More</a>
              <button
                type="button"
                class="v-btn v-btn--ghost v-btn--sm"
                data-request-demo
                data-whatsapp="{{ whatsapp_number }}"
                data-message="{{ quote_message | strip | escape }}"
              >
                Get Quote
              </button>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vesper featured products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Leading agricultural technology equipment"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number (digits only)",
      "default": "61448290926"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product name",
          "default": "Autosteering System"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback asset filename",
          "info": "Theme asset filename, e.g. products-af718.webp"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
