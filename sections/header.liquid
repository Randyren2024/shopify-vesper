{%- comment -%}
  Vesper header.

  Products has a click-to-open dropdown menu.
  The dropdown items come from a Shopify navigation menu picked in the
  theme editor (setting: products_menu).
{%- endcomment -%}

{%- liquid
  assign anchor_prefix = ''
  if template.name != 'index'
    assign anchor_prefix = routes.root_url
  endif

  assign products_menu = linklists[section.settings.products_menu]
-%}

<nav class="site-header fixed top-0 left-0 right-0 z-50 v-headerbar">
  <div class="site-header__inner v-container">
    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <img
        class="v-logo v-logo--on-light"
        alt="{{ shop.name | escape }}"
        src="{{ 'vesper-logo.svg' | asset_url }}"
        width="557"
        height="83"
      >
      <img
        class="v-logo v-logo--on-dark"
        alt=""
        src="{{ 'vesper-logo-white.svg' | asset_url }}"
        width="557"
        height="83"
        aria-hidden="true"
      >
    </a>

    <div class="site-header__right">
      <div class="site-header__nav">

        {%- for block in section.blocks -%}

          {%- if block.settings.label == 'Products' and products_menu.links.size > 0 -%}

            <div class="site-dropdown" data-products-dropdown>
              <button
                type="button"
                class="site-link"
                aria-expanded="false"
                data-products-toggle
              >
                {{ block.settings.label }}

                <span class="site-dropdown__chevron" data-products-chevron>
                  {% render 'vesper-icons', icon: 'chevron-down' %}
                </span>
              </button>

              <div
                class="site-dropdown__menu"
                data-products-menu
              >
                {%- for link in products_menu.links -%}
                  <a href="{{ link.url }}" class="site-dropdown__link">{{ link.title }}</a>
                {%- endfor -%}
              </div>
            </div>

          {%- else -%}

            {%- assign first_char = block.settings.link | slice: 0, 1 -%}
            {%- assign nav_url = block.settings.link -%}

            {%- if first_char == '#' -%}
              {%- assign nav_url = anchor_prefix | append: block.settings.link -%}
            {%- endif -%}

            <a
              href="{{ nav_url }}"
              class="site-link"
              {{ block.shopify_attributes }}
            >{{ block.settings.label }}</a>

          {%- endif -%}

        {%- endfor -%}

        {%- if section.settings.cta_label != blank -%}

          {%- assign cta_first_char = section.settings.cta_link | slice: 0, 1 -%}
          {%- assign cta_url = section.settings.cta_link -%}

          {%- if cta_first_char == '#' -%}
            {%- assign cta_url = anchor_prefix | append: section.settings.cta_link -%}
          {%- endif -%}

          <a
            href="{{ cta_url }}"
            class="site-header__cta v-btn v-btn--primary"
          >{{ section.settings.cta_label }}</a>

        {%- endif -%}

      </div>

      <div class="site-header__actions">
      <button
        type="button"
        class="v-theme-toggle site-icon-btn"
        data-theme-toggle
        aria-label="{{ 'accessibility.theme_toggle' | t }}"
        aria-pressed="false"
      >
        <span class="v-theme-toggle__icon v-theme-toggle__icon--moon">{% render 'vesper-icons', icon: 'moon' %}</span>
        <span class="v-theme-toggle__icon v-theme-toggle__icon--sun">{% render 'vesper-icons', icon: 'sun' %}</span>
      </button>

      {%- comment -%} 购物车 / 账号入口：主页与全站共用同一个 header，保证每个页面都能进购物车 {%- endcomment -%}
      <a
        href="{{ routes.cart_url }}"
        class="site-icon-btn"
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        {% render 'vesper-icons', icon: 'cart' %}
        {%- if cart.item_count > 0 -%}
          <span
            class="site-cart-count"
          >{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="site-icon-btn"
          aria-label="{{ 'accessibility.account' | t }}"
        >
          {% render 'vesper-icons', icon: 'user' %}
        </a>
      {%- endif -%}

      <button
        type="button"
        class="site-icon-btn site-header__toggle"
        aria-label="{{ 'accessibility.menu' | t }}"
        aria-controls="mobile-menu-panel"
        aria-expanded="false"
        data-menu-toggle
      >
        {% render 'vesper-icons', icon: 'menu' %}
      </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu-panel"
    class="site-mobile"
    hidden
    data-menu-panel
  >
    <div class="site-mobile__inner">

      {%- for block in section.blocks -%}

        {%- if block.settings.label == 'Products' and products_menu.links.size > 0 -%}

          <button
            type="button"
            class="site-mobile__link site-mobile__toggle"
            data-mobile-products-toggle
            aria-expanded="false"
          >
            <span>{{ block.settings.label }}</span>

            <span class="site-dropdown__chevron" data-mobile-products-chevron>
              {% render 'vesper-icons', icon: 'chevron-down' %}
            </span>
          </button>

          <div
            class="site-mobile__products"
            data-mobile-products-menu
          >
            {%- for link in products_menu.links -%}
              <a href="{{ link.url }}" class="site-dropdown__link">{{ link.title }}</a>
            {%- endfor -%}
          </div>

        {%- else -%}

          {%- assign first_char = block.settings.link | slice: 0, 1 -%}
          {%- assign nav_url = block.settings.link -%}

          {%- if first_char == '#' -%}
            {%- assign nav_url = anchor_prefix | append: block.settings.link -%}
          {%- endif -%}

          <a
            href="{{ nav_url }}"
            class="site-mobile__link"
          >{{ block.settings.label }}</a>

        {%- endif -%}

      {%- endfor -%}

      {%- if section.settings.cta_label != blank -%}

        {%- assign cta_first_char = section.settings.cta_link | slice: 0, 1 -%}
        {%- assign cta_url = section.settings.cta_link -%}

        {%- if cta_first_char == '#' -%}
          {%- assign cta_url = anchor_prefix | append: section.settings.cta_link -%}
        {%- endif -%}

        <a
          href="{{ cta_url }}"
          class="site-header__cta v-btn v-btn--primary"
        >{{ section.settings.cta_label }}</a>

      {%- endif -%}

    </div>
  </div>
</nav>

<style>
  .v-pmenu {
    min-width: 240px;
    max-width: 340px;
    padding: 6px 0;
    background: rgb(248, 247, 244);
    border: 1px solid rgba(17, 17, 16, 0.1);
    box-shadow: 0 18px 40px rgba(17, 17, 16, 0.14);
    animation: v-pmenu-in 0.16s ease;
  }

  @keyframes v-pmenu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .v-pmenu__link {
    display: block;
    padding: 11px 20px;
    font-family: Barlow, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(17, 17, 16);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .v-pmenu__link:hover {
    background: rgba(17, 17, 16, 0.05);
    border-left-color: #8de600;
  }

  .v-pmenu-mobile {
    padding: 4px 0 8px;
  }

  .v-pmenu__link--mobile {
    padding: 10px 0 10px 14px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    const dropdown = document.querySelector('[data-products-dropdown]');
    const toggle = document.querySelector('[data-products-toggle]');
    const menu = document.querySelector('[data-products-menu]');
    const chevron = document.querySelector('[data-products-chevron]');

    if (dropdown && toggle && menu) {

      toggle.addEventListener('click', function (event) {
        event.stopPropagation();

        const isOpen = menu.style.display === 'block';

        menu.style.display = isOpen ? 'none' : 'block';

        toggle.setAttribute(
          'aria-expanded',
          isOpen ? 'false' : 'true'
        );

        if (chevron) {
          chevron.style.transform = isOpen
            ? 'rotate(0deg)'
            : 'rotate(180deg)';
        }
      });

      document.addEventListener('click', function (event) {

        if (!dropdown.contains(event.target)) {

          menu.style.display = 'none';

          toggle.setAttribute(
            'aria-expanded',
            'false'
          );

          if (chevron) {
            chevron.style.transform = 'rotate(0deg)';
          }
        }

      });

    }

    const mobileToggle =
      document.querySelector('[data-mobile-products-toggle]');

    const mobileMenu =
      document.querySelector('[data-mobile-products-menu]');

    const mobileChevron =
      document.querySelector('[data-mobile-products-chevron]');

    if (mobileToggle && mobileMenu) {

      mobileToggle.addEventListener('click', function () {

        const isOpen =
          mobileMenu.style.display === 'block';

        mobileMenu.style.display =
          isOpen ? 'none' : 'block';

        mobileToggle.setAttribute(
          'aria-expanded',
          isOpen ? 'false' : 'true'
        );

        if (mobileChevron) {
          mobileChevron.style.transform = isOpen
            ? 'rotate(0deg)'
            : 'rotate(180deg)';
        }

      });

    }

  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "BOOK A DEMO"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Button link",
      "info": "A URL or an anchor such as #demo",
      "default": "#demo"
    },
    {
      "type": "header",
      "content": "Products dropdown"
    },
    {
      "type": "link_list",
      "id": "products_menu",
      "label": "Products menu",
      "info": "Navigation menu shown inside the Products dropdown."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "info": "A URL or an anchor such as #faq"
        }
      ]
    }
  ]
}
{% endschema %}