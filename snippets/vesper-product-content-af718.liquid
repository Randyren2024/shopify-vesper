  </div>
</section>

<section class="vpd-section" id="specifications" data-reveal>
  <div class="v-container">
    <h2 class="vpd-section-title">Specifications</h2>
    <div class="vpd-specs">
      <div class="v-tabs vpd-specs__tabs" data-tabs>
        <div class="v-tabs__list" role="tablist">
          <button type="button" class="v-tabs__tab" data-tab="GNSS Receiver" aria-selected="true" role="tab">GNSS Receiver</button>
          <button type="button" class="v-tabs__tab" data-tab="Tablet Display" aria-selected="false" role="tab">Tablet Display</button>
          <button type="button" class="v-tabs__tab" data-tab="Motor" aria-selected="false" role="tab">Motor</button>
        </div>
        <div class="v-tabs__panel" data-tab-panel="GNSS Receiver" role="tabpanel">
          <table class="v-specs-table">
            <tbody>
              {%- assign rows = af718_g1 | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign r = row | strip -%}
                {%- if r != blank -%}
                  {%- assign kv = r | split: '=' -%}
                  <tr><th>{{ kv | first | escape }}</th><td>{{ kv | last | escape }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <div class="v-tabs__panel" data-tab-panel="Tablet Display" role="tabpanel" hidden>
          <table class="v-specs-table">
            <tbody>
              {%- assign rows = af718_g2 | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign r = row | strip -%}
                {%- if r != blank -%}
                  {%- assign kv = r | split: '=' -%}
                  <tr><th>{{ kv | first | escape }}</th><td>{{ kv | last | escape }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <div class="v-tabs__panel" data-tab-panel="Motor" role="tabpanel" hidden>
          <table class="v-specs-table">
            <tbody>
              {%- assign rows = af718_g3 | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign r = row | strip -%}
                {%- if r != blank -%}
                  {%- assign kv = r | split: '=' -%}
                  <tr><th>{{ kv | first | escape }}</th><td>{{ kv | last | escape }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="vpd-more">
      <button type="button" class="v-btn v-btn--ghost" data-request-demo data-message="Hello! I'm interested in getting a quote for the {{ vpd_code }} {{ vpd_name }}. Could you please provide more information?">Learn More About Specifications →</button>
    </div>
  </div>
</section>

<section class="vpd-section vpd-section--tint" id="faq" data-reveal>
  <div class="v-container">
    <h2 class="vpd-section-title">Frequently Asked Questions</h2>
    <div class="v-accordion vpd-faq__accordion" data-accordion>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>What vehicles is AF718 compatible with?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">AF718 is compatible with most agricultural tractors and heavy machinery including John Deere, Case IH, New Holland, and other major brands. It supports diverse farming applications from plowing to harvesting.</p>
        </div>
      </div>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>Does it require internet connectivity?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">No, AF718 uses GNSS satellite positioning and does not require internet for basic operation. Multi-machine collaboration can even exchange data without network connectivity.</p>
        </div>
      </div>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>What satellite systems does AF718 support?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">AF718 supports BDS (B1I/B2I/B3I/B1C/B2a/B2b), GPS (L1C/A/L2P/L2C/L5), GLONASS (G1/G2), Galileo (E1/E5a/E5b/E6), QZSS (L1/L2/L5), and L-Band.</p>
        </div>
      </div>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>Can AF718 be upgraded with AI features?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">Yes, AF718 comes with AI expansion interfaces enabling seamless integration of advanced intelligent algorithms. The AN-V100 AI Visual Guidance module supports real-time crop boundary detection and autonomous row following.</p>
        </div>
      </div>
    </div>
    <div class="vpd-more">
      <button type="button" class="v-btn v-btn--ghost" data-request-demo data-message="Hello! I'm interested in getting a quote for the {{ vpd_code }} {{ vpd_name }}. Could you please provide more information?">Learn More →</button>
    </div>
  </div>
</section>

