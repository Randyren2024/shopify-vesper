      <div class="v-carousel__nav">
        <button type="button" class="v-carousel__btn" data-carousel-prev aria-label="Previous application">
          {%- render 'vesper-icons', icon: 'chevron-left' -%}
        </button>
        <button type="button" class="v-carousel__btn" data-carousel-next aria-label="Next application">
          {%- render 'vesper-icons', icon: 'chevron-right' -%}
        </button>
      </div>
