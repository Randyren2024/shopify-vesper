            <h3>Smart Path Planning</h3>
          </div>
        </div>
        <div class="v-carousel__slide">
          <div class="vpd-app-card">
            <div class="vpd-app-card__icon"><img class="vpd-app-card__img" src="{{ 'af718-ai-visual-guidance-1.png' | asset_url }}" alt="AI Visual Guidance" loading="lazy"></div>
            <h3>AI Visual Guidance</h3>
          </div>
        </div>
        <div class="v-carousel__slide">
          <div class="vpd-app-card">
            <div class="vpd-app-card__icon"><img class="vpd-app-card__img" src="{{ 'af718-implement-guidance-1.png' | asset_url }}" alt="Implement Guidance" loading="lazy"></div>
            <h3>Implement Guidance</h3>
          </div>
        </div>
        <div class="v-carousel__slide">
          <div class="vpd-app-card">
            <div class="vpd-app-card__icon">{% render 'vesper-icons', icon: 'grid' %}</div>
