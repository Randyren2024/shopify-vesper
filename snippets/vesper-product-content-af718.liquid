          </div>
        </div>
        <div class="v-carousel__slide">
          <div class="vpd-app-card">
            <div class="vpd-app-card__icon">{% render 'vesper-icons', icon: 'grid' %}</div>
            <h3>Fleet Management</h3>
          </div>
