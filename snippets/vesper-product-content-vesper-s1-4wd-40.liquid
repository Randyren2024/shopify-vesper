{%- comment -%}
  Vesper product rich content — S1 4WD 40° (Remote Control Lawn Mower — 85% Slope (Wide Wheel)).
  Static content ported from vesper_vue/src/data/products.ts.
{%- endcomment -%}
{%- assign vpd_code = code | default: 'S1 4WD 40°' -%}
{%- assign vpd_name = name | default: 'Remote Control Lawn Mower — 85% Slope (Wide Wheel)' -%}

{%- capture s1_40_g1 -%}
Max Slope=40° (85% Grade)
Obstacle Clearance=10 cm
Cutting Width=53 cm (21")
Peak Cutting Power=1985 W
Cutting Torque=8.13 N·m
Max Tall Grass Cut=130 cm
Top Speed=1.5 m/s
Cutting Efficiency=2000 ㎡/hr
{%- endcapture -%}

{%- capture s1_40_g2 -%}
Battery=56V automotive-grade LiFePO₄
Battery Capacity=12Ah (3000 ㎡) / 18Ah (4500 ㎡)
Cycle Life=1500+ cycles (3× industry average)
Runtime (12Ah)=Up to 1.5 hours
Runtime (18Ah)=Up to 2.25 hours
Charging Time (600W)=~70 min (12Ah) / ~90 min (18Ah)
Drive=4-Motor AWD, 4× independent brushless, 1000W traction output
Control=FOC torque control, electronic braking, 5ms response
{%- endcapture -%}

{%- capture s1_40_g3 -%}
Chassis=Aircraft-grade aluminum alloy
Deck Material=DC06 deep-draw stamped steel
Tires=Wide TPU tread wheels, puncture-free
Weight=64 kg
Remote Control=DJI-grade, 5ms response, 400m range
Safety=4 ultrasonic sensors + front bumper, tilt/roll auto-stop
Vacuum Suction=931 CFM, 70 L collection bag
Modes=Discharge, Mulch, Bag, Leaf Shredding Vacuum
Warranty=24-month (main unit, remote, battery)
{%- endcapture -%}

<section class="vpd-section" id="overview" data-reveal>
  <div class="v-container">
    <h2 class="vpd-section-title">Learn More About {{ vpd_code }} {{ vpd_name }}</h2>
    <div class="vpd-learn__cards">
      <article class="vpd-learn-card">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-remote.webp' | asset_url }}" width="1079" height="1079" alt="Wide TPU Tread Wheels" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Wide TPU Tread Wheels</h3>
          <p class="vpd-learn-card__desc">Wider contact patch for maximum grip on 40° (85% Grade) slopes, soft soil, and wet grass. Puncture-free TPU construction stands up to rocks, thorns, and rough terrain that would flat a pneumatic tire.</p>
        </div>
      </article>
      <article class="vpd-learn-card vpd-learn-card--reverse">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-tall-grass.webp' | asset_url }}" width="1079" height="1079" alt="1985W Peak Cutting Power" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">1985W Peak Cutting Power</h3>
          <p class="vpd-learn-card__desc">8.13 N·m of cutting torque chews through 1.3 m tall grass, wet matted patches, and tough weeds without stalling. High-lift blade creates strong airflow for a clean, even cut on the first pass.</p>
        </div>
      </article>
      <article class="vpd-learn-card">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-vacuum.webp' | asset_url }}" width="1079" height="1079" alt="Multi-Season Yard Care" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Multi-Season Yard Care</h3>
          <p class="vpd-learn-card__desc">Switch between Discharge, Mulch, Bag, and the 931 CFM leaf-shredding vacuum. The 70 L collection bag turns autumn leaves into fine mulch in one pass.</p>
        </div>
      </article>
      <article class="vpd-learn-card vpd-learn-card--reverse">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-steel-deck.webp' | asset_url }}" width="1258" height="1300" alt="Engineered Like a Tank" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Engineered Like a Tank</h3>
          <p class="vpd-learn-card__desc">Aircraft-grade aluminum chassis paired with DC06 deep-draw stamped steel deck stands up to commercial-duty use. Modular, service-friendly design — replace blades, batteries, and key parts in minutes.</p>
        </div>
      </article>
      <article class="vpd-learn-card">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-no-rtk.webp' | asset_url }}" width="212" height="212" alt="Ready in Seconds" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Ready in Seconds</h3>
          <p class="vpd-learn-card__desc">No RTK base station, no app pairing, no fuel. Pick up the DJI-grade remote and the S1 connects in under 5 seconds. Mow from up to 400 m away.</p>
        </div>
      </article>
      <article class="vpd-learn-card vpd-learn-card--reverse">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-local-repair.webp' | asset_url }}" width="840" height="940" alt="Local AU Support" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Local AU Support</h3>
          <p class="vpd-learn-card__desc">Local repair hubs in NSW and Victoria, 2-year warranty on the main unit, remote, and battery, and 30-day return policy. Support team responds within 2 business days.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="vpd-section vpd-section--tint" id="specifications" data-reveal>
  <div class="v-container">
    <h2 class="vpd-section-title">Specifications</h2>
    <div class="vpd-specs">
      <div class="v-tabs vpd-specs__tabs" data-tabs>
        <div class="v-tabs__list" role="tablist">
          <button type="button" class="v-tabs__tab" data-tab="Performance" aria-selected="true" role="tab">Performance</button>
          <button type="button" class="v-tabs__tab" data-tab="Power &amp; Battery" aria-selected="false" role="tab">Power &amp; Battery</button>
          <button type="button" class="v-tabs__tab" data-tab="Build &amp; Safety" aria-selected="false" role="tab">Build &amp; Safety</button>
        </div>
        <div class="v-tabs__panel" data-tab-panel="Performance" role="tabpanel">
          <table class="v-specs-table">
            <tbody>
              {%- assign rows = s1_40_g1 | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign r = row | strip -%}
                {%- if r != blank -%}
                  {%- assign kv = r | split: '=' -%}
                  <tr><th>{{ kv | first | escape }}</th><td>{{ kv | last | escape }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <div class="v-tabs__panel" data-tab-panel="Power &amp; Battery" role="tabpanel" hidden>
          <table class="v-specs-table">
            <tbody>
              {%- assign rows = s1_40_g2 | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign r = row | strip -%}
                {%- if r != blank -%}
                  {%- assign kv = r | split: '=' -%}
                  <tr><th>{{ kv | first | escape }}</th><td>{{ kv | last | escape }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <div class="v-tabs__panel" data-tab-panel="Build &amp; Safety" role="tabpanel" hidden>
          <table class="v-specs-table">
            <tbody>
              {%- assign rows = s1_40_g3 | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign r = row | strip -%}
                {%- if r != blank -%}
                  {%- assign kv = r | split: '=' -%}
                  <tr><th>{{ kv | first | escape }}</th><td>{{ kv | last | escape }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="vpd-more">
      <button type="button" class="v-btn v-btn--ghost" data-request-demo data-message="Hello! I'm interested in getting a quote for the {{ vpd_code }} {{ vpd_name }}. Could you please provide more information?">Learn More About Specifications →</button>
    </div>
  </div>
</section>

<section class="vpd-section" id="faq" data-reveal>
  <div class="v-container">
    <h2 class="vpd-section-title">Frequently Asked Questions</h2>
    <div class="v-accordion vpd-faq__accordion" data-accordion>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>How is the 40° Wide Wheel edition different from the 50° model?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">Both use the same 4-Motor AWD platform, 53 cm deck, and 1985W peak power. The 40° Wide Wheel edition is tuned for slightly less extreme slopes and uses wider TPU tread tires for a larger contact patch — preferred for soft soil, mud, and customers who want extra stability at the cost of maximum slope rating.</p>
        </div>
      </div>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>What is the difference between the 50° Grip Tread and 40° Wide Wheel editions?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">Both use the same 4-Motor AWD platform, 53 cm deck, and 1985W peak power. The 50° Grip Tread edition uses aggressive tread tires for maximum slope climbing on 50° (119% grade) terrain. The 40° Wide Wheel edition uses wider TPU tires for a larger contact patch — preferred for soft soil, mud, and customers who want extra stability.</p>
        </div>
      </div>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>How long does the battery last and what is the maximum mowing area?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">Powered by 56V LiFePO₄ batteries with 1500 cycles — 3× the industry average. The 18Ah battery runs up to 2h 15m and covers up to 4500 ㎡ per charge. The 12Ah runs up to 1h 30m and covers 3000 ㎡.</p>
        </div>
      </div>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>What safety features protect the operator and bystanders?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">The S1 has 4 ultrasonic sensors that detect obstacles, people, and pets — slowing or stopping the machine and blades on approach. A front bumper adds an impact buffer. Tilt and roll-over sensors automatically stop the blades if the unit tips beyond a safe angle.</p>
        </div>
      </div>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>Is it controlled only by a remote, and how far does it reach?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">Yes — operated entirely by the included remote control. Signal range reaches up to 400 m. For safety and visual range, 100 m is the recommended working distance.</p>
        </div>
      </div>
      <div class="v-accordion__item" data-open="false">
        <button type="button" class="v-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span>What mowing modes are available?</span>
          {%- render 'vesper-icons', icon: 'chevron-down' -%}
        </button>
        <div class="v-accordion__panel">
          <p class="vpd-faq-answer">Three primary modes: Mulching, Bagging, and Rear Discharge. The 4-in-1 add-on adds the 931 CFM leaf-shredding vacuum for fall cleanup.</p>
        </div>
      </div>
    </div>
    <div class="vpd-more">
      <button type="button" class="v-btn v-btn--ghost" data-request-demo data-message="Hello! I'm interested in getting a quote for the {{ vpd_code }} {{ vpd_name }}. Could you please provide more information?">Learn More →</button>
    </div>
  </div>
</section>

