{%- comment -%}
  Vesper product rich content — S1 4WD 50° (Remote Control Lawn Mower — 119% Slope, Grip Tread).
  Static content ported from vesper_vue/src/data/products.ts.
{%- endcomment -%}
{%- assign vpd_code = code | default: 'S1 4WD 50°' -%}
{%- assign vpd_name = name | default: 'Remote Control Lawn Mower — 119% Slope (Grip Tread)' -%}

{%- capture s1_4wd_50_g1 -%}
Max Slope=50° (119% Grade)
Obstacle Clearance=10 cm
Cutting Width=53 cm (21")
Peak Cutting Power=1985 W
Cutting Torque=8.13 N·m
Max Tall Grass Cut=130 cm
Top Speed=1.5 m/s
Cutting Efficiency=2000 ㎡/hr (3× coverage)
{%- endcapture -%}

{%- capture s1_4wd_50_g2 -%}
Battery=56V automotive-grade LiFePO₄
Battery Capacity=12Ah (3000 ㎡) / 18Ah (4500 ㎡)
Cycle Life=1500+ cycles (3× industry average)
Runtime (12Ah)=Up to 1.5 hours
Runtime (18Ah)=Up to 2.25 hours
Charging Time (600W)=~70 min (12Ah) / ~90 min (18Ah)
Drive=4-Motor AWD, 4× independent brushless, 1000W traction output
Control=FOC torque control, electronic braking, 5ms response
{%- endcapture -%}

{%- capture s1_4wd_50_g3 -%}
Chassis=High-clearance aluminum alloy (aircraft-grade)
Deck Material=DC06 deep-draw stamped steel
Tires=12mm non-directional tread teeth, semi-solid TPU
Weight=64 kg
Remote Control=DJI-grade, 5ms response, 400m range
Safety=4 ultrasonic sensors + front bumper, tilt/roll auto-stop
Vacuum Suction=931 CFM, 70 L collection bag
Modes=Discharge, Mulch, Bag, Leaf Shredding Vacuum
Warranty=24-month (main unit, remote, battery)
{%- endcapture -%}

<section class="vpd-section" id="overview" data-reveal>
  <div class="v-container">
    <h2 class="vpd-section-title">Learn More About {{ vpd_code }} {{ vpd_name }}</h2>
    <div class="vpd-learn__cards">
      <article class="vpd-learn-card">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-remote.webp' | asset_url }}" width="1079" height="1079" alt="All-Wheel Beast Drive" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">All-Wheel Beast Drive</h3>
          <p class="vpd-learn-card__desc">4-Motor AWD with 4× independent brushless motors delivers 1000W of traction output. Combined with 12mm grip-tread tires, the S1 4WD maintains grip on 50° slopes, wet grass, and loose soil — terrain that defeats walk-behind and ride-on mowers.</p>
        </div>
      </article>
      <article class="vpd-learn-card vpd-learn-card--reverse">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-tall-grass.webp' | asset_url }}" width="1079" height="1079" alt="1985W Peak Cutting Power" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">1985W Peak Cutting Power</h3>
          <p class="vpd-learn-card__desc">8.13 N·m of cutting torque chews through 1.3 m tall grass, wet matted patches, and tough weeds without stalling. The high-lift blade creates strong airflow that stands grass up for a clean, even cut on the first pass.</p>
        </div>
      </article>
      <article class="vpd-learn-card">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-vacuum.webp' | asset_url }}" width="1079" height="1079" alt="Multi-Season Yard Care" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Multi-Season Yard Care</h3>
          <p class="vpd-learn-card__desc">Switch between Discharge, Mulch, Bag, and the 931 CFM leaf-shredding vacuum. The 70 L collection bag turns autumn leaves into fine mulch in one pass — replace the rake, blower, and chipper with a single machine.</p>
        </div>
      </article>
      <article class="vpd-learn-card vpd-learn-card--reverse">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-aluminum.webp' | asset_url }}" width="1258" height="1300" alt="Engineered Like a Tank" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Engineered Like a Tank</h3>
          <p class="vpd-learn-card__desc">Aircraft-grade aluminum chassis paired with DC06 deep-draw stamped steel deck stands up to commercial-duty use. Modular, service-friendly design — replace blades, batteries, and key parts in minutes with no specialized tools.</p>
        </div>
      </article>
      <article class="vpd-learn-card">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-no-rtk.webp' | asset_url }}" width="212" height="212" alt="Ready in Seconds" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Ready in Seconds</h3>
          <p class="vpd-learn-card__desc">No RTK base station to set up, no app to pair, no fuel to mix. Pick up the DJI-grade remote and the S1 connects in under 5 seconds. Mow from up to 400 m away — from the porch, the shade, or the office window.</p>
        </div>
      </article>
      <article class="vpd-learn-card vpd-learn-card--reverse">
        <div class="vpd-learn-card__image">
          <img src="{{ 'vesper-local-repair.webp' | asset_url }}" width="840" height="940" alt="Local AU Support" loading="lazy">
        </div>
        <div class="vpd-learn-card__body">
          <h3 class="vpd-learn-card__title">Local AU Support</h3>
          <p class="vpd-learn-card__desc">Local repair hubs in NSW and Victoria, 2-year warranty on the main unit, remote, and battery, and 30-day return policy. Vesper AU is engineered by former DJI experts and supported by a local team that responds within 2 business days.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="vpd-section vpd-section--tint" id="specifications" data-reveal>
  <div class="v-container">
    <h2 class="vpd-section-title">Specifications</h2>
    <div class="vpd-specs">
      <div class="v-tabs vpd-specs__tabs" data-tabs>
        <div class="v-tabs__list" role="tablist">
          <button type="button" class="v-tabs__tab" data-tab="Performance" aria-selected="true" role="tab">Performance</button>
          <button type="button" class="v-tabs__tab" data-tab="Power &amp; Battery" aria-selected="false" role="tab">Power &amp; Battery</button>
          <button type="button" class="v-tabs__tab" data-tab="Build &amp; Safety" aria-selected="false" role="tab">Build &amp; Safety</button>
        </div>
        <div class="v-tabs__panel" data-tab-panel="Performance" role="tabpanel">
          <table class="v-specs-table">
            <tbody>
              {%- assign rows = s1_4wd_50_g1 | newline_to_br | split: '<br />' -%}
              {%- for row in rows -%}
                {%- assign r = row | strip -%}
                {%- if r != blank -%}
                  {%- assign kv = r | split: '=' -%}
                  <tr><th>{{ kv | first | escape }}</th><td>{{ kv | last | escape }}</td></tr>
                {%- endif -%}
              {%- endfor -%}
