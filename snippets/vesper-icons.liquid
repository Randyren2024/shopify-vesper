{%- comment -%}
  Vesper icon set. Ported from src/components/icons/*.vue and the Ant Design
  icons used across the Vue app.

  Usage: {% render 'vesper-icons', icon: 'cart', class: 'v-icon' %}
{%- endcomment -%}

{%- liquid
  assign icon_class = class | default: 'v-icon'
-%}

{%- case icon -%}
