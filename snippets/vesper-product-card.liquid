{%- comment -%}
  Product card — aligned with Nuxt web/app/components/ProductCard.vue.

  Dynamic Shopify product usage:
    {% render 'vesper-product-card', product: product %}

  The optional static arguments remain supported for legacy/manual sections.
{%- endcomment -%}

{%- liquid
  if product
    assign card_url = product.url
    assign card_title = product.title
    assign card_desc = product.description | strip_html | strip | truncate: 118
    assign card_category = product.type | default: 'Vesper'
    assign card_price = product.price
    assign card_compare_at = product.compare_at_price
    assign card_image_alt = product.featured_image.alt | default: card_title
    assign card_flag = blank

    if product.tags contains 'New Release' or product.tags contains 'New'
      assign card_flag = 'New'
    elsif product.tags contains 'Best Seller'
      assign card_flag = 'Best seller'
    endif
  else
    assign card_url = '/products/' | append: id
    assign card_title = code | append: ' ' | append: name
    assign card_desc = description | strip_html | strip | truncate: 118
    assign card_category = category_name | default: 'Vesper'
    assign card_price = price
    assign card_compare_at = blank
    assign card_flag = blank

    if is_new
      assign card_flag = 'New'
    elsif bestseller
      assign card_flag = 'Best seller'
    endif
  endif
-%}

<a
  class="p-card v-product-card v-card v-card-hover"
  href="{{ card_url }}"
  data-category="{{ category | default: card_category | handleize }}"
  data-price="{{ card_price }}"
  data-reveal
  aria-label="{{ card_title | escape }}"
>
  <div class="p-card__media v-product-card__media">
    {%- if product and product.featured_image -%}
      {{
        product.featured_image
        | image_url: width: 1000
        | image_tag:
          class: 'v-product-card__img',
          widths: '320, 480, 640, 800, 1000',
          sizes: '(min-width: 1200px) 360px, (min-width: 768px) 33vw, 50vw',
          alt: card_image_alt,
          loading: 'lazy',
          decoding: 'async'
      }}
    {%- elsif image != blank -%}
      <img
        class="v-product-card__img"
        src="{{ image | asset_url }}" width="800" height="800"
        alt="{{ card_title | escape }}"
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}

    {%- if card_flag != blank -%}
      <span class="v-badge v-badge--solid p-card__flag v-product-card__badge">
        {{ card_flag }}
      </span>
    {%- endif -%}
  </div>

  <div class="p-card__body v-product-card__body">
    <span class="p-card__cat v-product-card__category">
      {{ card_category | default: 'Vesper' }}
    </span>

    <h3 class="p-card__title v-product-card__title">{{ card_title | escape }}</h3>

    {%- if card_desc != blank -%}
      <p class="p-card__desc v-product-card__desc">{{ card_desc | escape }}</p>
    {%- endif -%}

    <div class="p-card__foot v-product-card__foot">
      <span class="p-card__price v-product-card__price">
        {%- if product -%}
          {%- if card_price > 0 -%}
            {{ card_price | money }}
          {%- else -%}
            Request a quote
          {%- endif -%}
        {%- elsif card_price != blank -%}
          {{ card_price }}
        {%- else -%}
          Request a quote
        {%- endif -%}

        {%- if product and card_compare_at > card_price -%}
          <small class="p-card__was v-product-card__was">{{ card_compare_at | money }}</small>
        {%- endif -%}
      </span>

      <span class="p-card__cta v-product-card__cta">
        View details
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </div>
</a>
